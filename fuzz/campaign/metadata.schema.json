{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Partitionline Fuzz Campaign Metadata Schema",
  "description": "Schema for sustained fuzz campaign execution metadata, corpus provenance, and retained failure tracking.",
  "type": "object",
  "required": [
    "kind",
    "campaign_id",
    "duration_seconds",
    "targets",
    "started_at",
    "finished_at",
    "toolchain",
    "source",
    "corpus",
    "coverage",
    "artifacts_dir"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["campaign"]
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 16
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "toolchain": {
      "type": "object",
      "required": ["rustc", "cargo"],
      "properties": {
        "rustc": { "type": "string" },
        "cargo": { "type": "string" },
        "cargo_fuzz": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["git_commit"],
      "properties": {
        "git_commit": { "type": "string" },
        "branch": { "type": "string" }
      }
    },
    "corpus": {
      "type": "object",
      "required": ["path", "input_count"],
      "properties": {
        "path": { "type": "string" },
        "seeds_path": { "type": "string" },
        "input_count": { "type": "integer", "minimum": 0 },
        "corpus_hashes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "corpus_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "coverage": {
      "oneOf": [
        { "type": "string", "enum": ["unavailable"] },
        {
          "type": "object",
          "properties": {
            "status": { "type": "string" },
            "line_coverage_pct": { "type": "number" },
            "branch_coverage_pct": { "type": "number" }
          }
        }
      ]
    },
    "artifacts_dir": {
      "type": "string"
    },
    "replayed_failures": {
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "replayed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "is_example": {
      "type": "boolean"
    }
  }
}
