  "equal_semantics": {
    "description": "A benchmark comparison is strictly invalid if durability/acks/idempotence/isolation/security differ. All comparison pairs must match across the frozen required match fields.",
    "required_match_fields": [
      "durability",
      "acks",
      "idempotence",
      "isolation",
      "security"
    ],
    "rules": [
      "Durability, min.insync.replicas, replication factor, and broker ISR topology must match across all compared peers.",
      "Producer acks level (0, 1, or -1/all) must be identical across compared clients.",
      "Idempotence must be identically configured (both enabled or both disabled); when enabled, max.in.flight.requests.per.connection must be bounded <= 5.",
      "Consumer isolation.level (read_uncommitted vs read_committed) must match across all compared clients.",
      "Security protocol (PLAINTEXT, SSL/TLS, SASL_PLAINTEXT, SASL_SSL) and authentication mechanism (PLAIN, SCRAM-SHA-256, SCRAM-SHA-512, OAUTHBEARER) must match.",
      "Enqueue acceptance (e.g. try_send returning Ok) is local buffering and must not be counted as broker acknowledgment; only broker produce responses count as acked.",
      "Broker acknowledgment is not proof of a per-record fsync; fsync depends on broker log.flush configuration and OS page cache writeback.",
      "High-watermark and count equality are necessary baseline assertions, but insufficient to establish exactly-once delivery; record payload and ID integrity must be verified."
    ]
  },
  "measurement_protocol": {
    "warmup": {
      "required": true,
      "min_duration_s": 15,
      "min_records": 10000,
      "percentile_inclusion": false,
      "description": "Warmup traffic must run prior to steady-state measurement to stabilize JIT, TCP connection caches, and broker thread pools. All warmup records are discarded from steady-state percentiles and throughput totals."
    },
    "repetitions": {
      "min_repetitions": 5,
      "pairing": "paired_randomized",
      "order": "randomized A/B or Latin square per repetition",
      "description": "At least five paired randomized repetitions per cell to neutralize temporal drift, background noise, and host thermal throttling."
    },
    "duration": {
      "steady_state_duration_s": 60,
      "min_record_count": 1000000,
      "description": "Each steady-state repetition must run for at least 60 seconds or until the sample floor is satisfied."
    },
    "sample_floor": {
      "min_latency_samples": 10000,
      "min_throughput_records": 1000000,
      "description": "Strict sample floor required before computing percentiles or statistical aggregates."
    },
    "uncertainty": {
      "metrics": [
        "p50",
        "p95",
        "p99",
        "p99.9",
        "mean",
        "min",
        "max",
        "throughput_rec_s"
      ],
      "confidence_level": 0.95,
      "method": "95% bootstrap confidence interval and median +- MAD (Median Absolute Deviation)",
      "description": "All published comparative results must report uncertainty intervals. Single-run peak values or unanchored point estimates are prohibited."
    },
    "failed_run_policy": {
      "rule": "A failed cell stays failed; rerun success does not erase it; no progress-string success.",
      "triggers": [
        "Broker error code returned (e.g. NOT_ENOUGH_REPLICAS, OUT_OF_ORDER_SEQUENCE_NUMBER)",
        "Missing or dropped records (sum of high watermarks != acked records)",
        "Connection reset, broken pipe, or unhandled socket timeout",
        "Client panic, SIGSEGV, unhandled exception, or unexpected termination",
        "Progress strings without verified end-to-end completion",
        "Latency sample count below declared sample floor"
      ],
      "rerun_erasure_forbidden": true,
      "progress_string_success_forbidden": true
    },
    "historical_lab_a_rules": {
      "reference_hardware": "Apple M4 Pro, macOS 26.6.2, arm64 (historical locked produce reference)",
      "broker": "Docker apache/kafka:3.9.1 on 127.0.0.1:9092 or native KRaft 3.9.1 / 4.1.0",
      "fresh_topic": "Topic must be deleted and recreated before each run",
      "high_watermark_audit": "kafka-get-offsets sum of partition high watermarks must strictly equal acked record count",
      "integrity_signoff": "Results are unsigned until Kernel Integrity signs; unsigned samples never lift Suite HOLD."
    },
    "universal_certification_disclaimer": "No universal Kafka performance certification exists in the inspected evidence. Repository targets and scorecard comparisons are proposed benchmarks, not industry-wide standards."
  },
