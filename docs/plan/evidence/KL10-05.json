{
 "id": "KL10-05",
 "status": "done",
 "disposition": "accepted",
 "decision": "change-default-to-zlib-rs",
 "baseline_sha": "65d3e89a4775f6bfd913ed1467647b93a11b9329",
 "maintainer_approval": {
  "by": "mingley (maintainer)",
  "date": "2026-10-01",
  "statements": [
   "make sure partitionline is also using the most CPU efficient/fastest option for this too",
   "you can make these changes to partitionline"
  ],
  "scope": "zlib-rs becomes the default gzip backend through a default `zlib-rs` cargo feature (flate2/zlib-rs); flate2 `runtime_detection` is enabled; `default-features = false` keeps miniz_oxide. Scoped exception to performance-leadership.md section 9 for this dependency only; partitionline's own unsafe_code = forbid is unchanged. The allocation-byte raise is approved separately as KL10-15."
 },
 "candidates": {
  "miniz_oxide 0.9.1 (current)": {
   "license": "MIT OR Zlib OR Apache-2.0",
   "unsafe": "#![forbid(unsafe_code)] in miniz_oxide; via flate2 the gzip CRC-32 uses crc32fast (15 unsafe lines, SIMD) and miniz_oxide's simd feature pulls simd-adler32 (36 unsafe lines; zlib-wrapped data only)",
   "simd": "none",
   "notes": "flate2 rust_backend; CRC-32 from crc32fast"
  },
  "zlib-rs 0.6.8": {
   "license": "Zlib (allowed by deny.toml)",
   "msrv": "1.75 (<= 1.85)",
   "unsafe": "469 source lines contain `unsafe`; 13 files use core::arch SIMD (adler32, crc32, compare256, inflate writer, cpu_features); 49 #[target_feature] functions",
   "fuzzing": "upstream fuzz targets: checksum, compress, compress_gz, end_to_end, infback, inflate_chunked, uncompress, uncompress_random_input",
   "maintenance": "Trifecta Tech Foundation (started under ISRG Prossimo); releases 0.6.6 2026-07-09, 0.6.7 2026-08-03, 0.6.8 2026-09-15; repo not archived",
   "allocator": "flate2 enables zlib-rs `rust-allocator`, so allocations go through the global allocator (visible to the census)",
   "runtime_detection": "without std (flate2 `runtime_detection` off) zlib-rs only uses compile-time SIMD (upstream issue #563)"
  },
  "excluded": "C backends (system zlib, zlib-ng, libdeflate): CONTRIBUTING.md forbids C compression libraries as default dependencies"
 },
 "dependency_graph": {
  "default": "partitionline -> flate2 1.1.10 -> {zlib-rs 0.6.8 (used), miniz_oxide 0.9.1 (compiled, unused at runtime)}",
  "no_default_features": "partitionline -> flate2 1.1.10 -> miniz_oxide 0.9.1",
  "lockfile_change": "adds zlib-rs 0.6.8 to Cargo.lock, benchmarks/codec, benchmarks/runtime and fuzz lockfiles"
 },
 "acceptance_met": [
  "Compress and decompress measured separately on the KL10-03 json1k cells (plus historical gzip cells) on arm64 (Apple M4 Pro, macOS) and x86_64 (Xeon Platinum 8573C, hosted Linux) with ratios; instructions on aarch64 and x86_64 Linux; gateway-adoption.md section 2 numbers not used as evidence.",
  "Both candidates audited for unsafe/SIMD use, fuzzing, maintenance, license and MSRV against performance-leadership.md section 9; partitionline's own unsafe_code = forbid unchanged.",
  "Manifest change approved by the maintainer and recorded here (maintainer_approval)."
