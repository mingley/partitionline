 ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
 cd "$ROOT"
 version="${1:?explicit current broker version required}"
@@ -18,6 +19,12 @@ source_sha="$(git rev-parse HEAD)"
 report="${PL_COMPAT_REPORT_DIR:-$ROOT/target/broker-compatibility/$version}"
