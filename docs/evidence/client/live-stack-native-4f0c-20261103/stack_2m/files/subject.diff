   -e KAFKA_LISTENERS=PLAINTEXT://:9092,INTERNAL://:9094,CONTROLLER://:9093 \
   -e "KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://127.0.0.1:$port,INTERNAL://localhost:9094" \
@@ -125,7 +132,18 @@ cargo test --locked --test broker_compatibility --no-run >"$report/build.log" 2>
 phase=runtime-required-profile
 export KAFKA_BOOTSTRAP="127.0.0.1:$port"
 export PL_COMPAT_REFERENCE="$reference" PL_COMPAT_SOURCE_SHA="$source_sha" PL_COMPAT_PREFIX="plcompat-${version//./-}"
+# Configure only Cargo's test runner; Cargo, rustc and build scripts retain
+# their default stack environment. The outer collector supplies a pinned script.
+if [[ -n "${PL_STACK_RUNTIME_MIN:-}" ]]; then
+  [[ "${PL_STACK_RUNTIME_MIN}" == 2097152 || "${PL_STACK_RUNTIME_MIN}" == 8388608 ]] || { echo 'invalid runtime stack value' >&2; exit 1; }
+  [[ "$(awk '$1 == "host:" {print $2}' "$report/rustc.log")" == x86_64-unknown-linux-gnu ]] || { echo 'unexpected Rust host' >&2; exit 1; }
+  [[ "${PL_STACK_RUNTIME_RUNNER:-}" == /* && -f "$PL_STACK_RUNTIME_RUNNER" && "$PL_STACK_RUNTIME_RUNNER" != *[[:space:]]* ]] || { echo 'invalid runtime stack runner path' >&2; exit 1; }
+  export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER="bash $PL_STACK_RUNTIME_RUNNER"
+fi
 cargo test --locked --test broker_compatibility -- --ignored --exact live_compatibility_required --nocapture >"$report/runtime.log" 2>&1
+# The stack investigation stops at classic join. Do not enter later scenarios.
+echo 'PL_STACK_CLASSIC_TEST_PROCESS_RETURNED'
+exit 0
 phase=independent-java-history-and-offsets
 prefix="plcompat-${version//./-}"
