+  [[ "${PL_STACK_RUN_TOKEN}" =~ ^[0-9a-f]{32}$ ]] || { echo 'invalid stack diagnostic token' >&2; exit 1; }
+  name="pl-stack-${PL_STACK_RUN_TOKEN}"
