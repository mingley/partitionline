+          python3 -B - <<'PY'
+          import hashlib, os, stat, sys
+          name = 'scripts/ci-verify-client-candidate-helpers.py'
+          directory = os.open('scripts', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+          try:
+              fd = os.open('ci-verify-client-candidate-helpers.py', os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory)
+              with os.fdopen(fd, 'rb') as stream:
+                  info = os.fstat(stream.fileno())
+                  if not stat.S_ISREG(info.st_mode) or info.st_size != 8759:
+                      raise SystemExit('candidate helper guard size or type mismatch')
+                  data = stream.read()
+          finally:
+              os.close(directory)
+          if len(data) != 8759 or hashlib.sha256(data).hexdigest() != 'b5f624d5d7ca13c479703416683c458fffae62f41ba885df0cc4c15a59c3a462':
+              raise SystemExit('candidate helper guard hash mismatch')
+          code = compile(data, name, 'exec')
