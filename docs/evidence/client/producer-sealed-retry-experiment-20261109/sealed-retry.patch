+fn valid_sealed_retry(batch: &[Pending]) -> bool {
+    let Some(first) = batch.first() else {
+        return false;
+    };
+    let (Some(base), Some(partition)) = (first.batch_base_seq, first.rec.partition) else {
+        return false;
+    };
+    if base < 0 || first.batch_len != batch.len() {
+        return false;
+    }
+    batch.iter().enumerate().all(|(index, pending)| {
+        let Ok(offset) = i32::try_from(index) else {
+            return false;
+        };
+        pending.is_rooted()
+            && pending.rec.topic == first.rec.topic
+            && pending.rec.partition == Some(partition)
+            && pending.epoch_gen == first.epoch_gen
+            && pending.batch_base_seq == Some(base)
+            && pending.batch_len == batch.len()
+            && pending.seq == Some(RecordBatch::increment_sequence(base, offset))
+    })
+}
