+// An already-sequenced partition group travels through this actor as one
+// message. This experimental path still lacks a partition/write identity fence.
+struct SealedRetryReceiver {
+    weak: std::sync::Weak<Shared>,
+    rx: mpsc::Receiver<Vec<Pending>>,
+}
+
+impl Drop for SealedRetryReceiver {
+    fn drop(&mut self) {
+        self.rx.close();
+        while let Ok(batch) = self.rx.try_recv() {
+            if let Some(shared) = self.weak.upgrade() {
+                let _count = RetryCountGuard {
+                    shared: &shared,
+                    count: batch.len(),
+                };
+                // Rooted leases return to the owner supervisor on drop.
+                drop(batch);
+            }
+        }
+    }
+}
+
+fn sealed_retry_loop(
+    weak: std::sync::Weak<Shared>,
+    rx: mpsc::Receiver<Vec<Pending>>,
+) -> impl std::future::Future<Output = ()> + Send {
+    let receiver = SealedRetryReceiver { weak, rx };
+    async move {
+        let mut receiver = receiver;
+        while let Some(batch) = receiver.rx.recv().await {
+            let Some(shared) = receiver.weak.upgrade() else {
+                break;
+            };
+            let _count = RetryCountGuard {
+                shared: &shared,
+                count: batch.len(),
+            };
+            retry_sealed_batch(&shared, batch).await;
+        }
+    }
+}
+
+async fn retry_sealed_batch(shared: &Arc<Shared>, mut batch: Vec<Pending>) {
+    let Some(first) = batch.first() else {
+        return;
+    };
+    let deadline = batch.iter().map(|pending| pending.deadline).min().unwrap_or(first.deadline);
+    let retry_after = batch.iter().map(|pending| pending.retry_after).max().unwrap_or(first.retry_after);
+    let topic = Arc::clone(&first.rec.topic);
+    let Some(partition) = first.rec.partition else {
+        return;
+    };
+    if shared.sticky.is_some() {
+        // Cohort rebind is not integrated yet. Dropping rooted leases closes
+        // admission and leaves terminal handling to the owner supervisor.
+        return;
+    }
+    if Instant::now() < retry_after {
+        tokio::time::sleep(retry_after.saturating_duration_since(Instant::now())).await;
+    }
+    if shared.closed.load(Ordering::SeqCst) || Instant::now() >= deadline {
+        return;
+    }
+    if !batch.iter().all(|pending| pending.skip_meta_refresh) {
+        invalidate_cached_topic(shared, topic.as_ref());
+        let rest = deadline.saturating_duration_since(Instant::now());
+        if rest.is_zero()
+            || partitions_for_timeout(shared, &topic, shared.cfg.request_timeout.min(rest))
+                .await
+                .is_err()
+        {
+            return;
+        }
+    }
+    for pending in &mut batch {
+        pending.skip_meta_refresh = false;
+    }
+    loop {
+        if shared.closed.load(Ordering::SeqCst) || Instant::now() >= deadline {
+            return;
+        }
+        let node = shared.cluster.lock().leader_id(topic.as_ref(), partition).ok();
+        if let Some(node) = node {
+            let slot = usize::try_from(partition).unwrap_or(0) % shared.cfg.connections.max(1);
+            try_nudge_slot(&shared.connect_tx, node, slot);
+            let worker = shared
+                .nodes
+                .lock()
+                .get(&node)
+                .and_then(|slots| slots.get(slot).cloned().flatten());
+            if let Some(worker) = worker {
+                if let Some(sender) = &worker.sealed_batch_tx {
+                    let rest = deadline.saturating_duration_since(Instant::now());
+                    match tokio::time::timeout(rest, sender.reserve()).await {
+                        Ok(Ok(permit)) => {
+                            let _commit = worker.admission.commit.lock();
+                            if worker.admission.is_accepting() {
+                                permit.send(batch);
+                                return;
+                            }
+                        }
+                        Ok(Err(_)) => {
+                            retire_closed_worker(shared, node, slot, &worker.id);
+                        }
+                        Err(_) => return,
+                    }
+                }
+            }
+        }
+        let notified = shared.cache_nudge.notified();
+        tokio::pin!(notified);
+        let rest = deadline.saturating_duration_since(Instant::now());
+        tokio::select! {
+            _ = notified => {}
+            _ = tokio::time::sleep(rest.min(Duration::from_millis(10))) => {}
+        }
+    }
 }
 
