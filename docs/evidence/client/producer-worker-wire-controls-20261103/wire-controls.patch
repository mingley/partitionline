+//! A real TCP stream that pauses after a counted prefix in unit tests.
+
+use std::io;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::task::{Context, Poll, Waker};
+
+use parking_lot::Mutex;
+use tokio::io::{AsyncRead, AsyncWrite, ReadBuf};
+use tokio::net::TcpStream;
+use tokio::sync::Notify;
+
+struct State {
+    written: usize,
+    released: bool,
+    writer: Option<Waker>,
+}
+
+struct Shared {
+    limit: usize,
+    state: Mutex<State>,
+    reached: Notify,
+}
+
+/// Cloneable control for a gate attached to one physical TCP stream.
+#[derive(Clone)]
+pub(crate) struct Gate(Arc<Shared>);
+
+impl Gate {
+    pub(super) fn new(limit: usize) -> Self {
+        assert!(limit > 0);
+        Self(Arc::new(Shared {
+            limit,
+            state: Mutex::new(State {
+                written: 0,
+                released: false,
+                writer: None,
+            }),
+            reached: Notify::new(),
+        }))
+    }
+
+    pub(crate) async fn reached(&self) {
+        loop {
+            let notified = self.0.reached.notified();
+            if self.0.state.lock().written >= self.0.limit {
+                return;
+            }
+            notified.await;
+        }
+    }
+
+    pub(crate) fn written(&self) -> usize {
+        self.0.state.lock().written
+    }
+
+    pub(crate) fn release(&self) {
+        let writer = {
+            let mut state = self.0.state.lock();
+            state.released = true;
+            state.writer.take()
+        };
+        if let Some(writer) = writer {
+            writer.wake();
+        }
+    }
+}
+
+pub(super) struct GatedTcp {
+    stream: TcpStream,
+    gate: Gate,
+}
+
+impl GatedTcp {
+    pub(super) fn new(stream: TcpStream, gate: Gate) -> Self {
+        Self { stream, gate }
+    }
+}
+
+impl AsyncRead for GatedTcp {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().stream).poll_read(cx, buf)
+    }
+}
+
+impl AsyncWrite for GatedTcp {
+    fn poll_write(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        let this = self.get_mut();
+        if buf.is_empty() {
+            return Pin::new(&mut this.stream).poll_write(cx, buf);
+        }
+        let offered = {
+            let mut state = this.gate.0.state.lock();
+            if !state.released && state.written >= this.gate.0.limit {
+                state.writer = Some(cx.waker().clone());
+                return Poll::Pending;
+            }
+            if state.released {
+                buf.len()
+            } else {
+                buf.len().min(this.gate.0.limit - state.written)
+            }
+        };
+        let Some(chunk) = buf.get(..offered) else {
+            return Poll::Ready(Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "test gate prefix exceeds buffer",
+            )));
+        };
+        let result = Pin::new(&mut this.stream).poll_write(cx, chunk);
+        if let Poll::Ready(Ok(n)) = &result {
+            let mut state = this.gate.0.state.lock();
+            if !state.released {
+                state.written += *n;
+                if state.written >= this.gate.0.limit {
+                    this.gate.0.reached.notify_one();
+                }
+            }
+        }
+        result
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().stream).poll_flush(cx)
+    }
+
+    fn poll_shutdown(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().stream).poll_shutdown(cx)
+    }
+}
