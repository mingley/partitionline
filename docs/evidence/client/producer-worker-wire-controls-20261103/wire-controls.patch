+// Keep this control on a real plaintext socket and negotiate that same socket
+// before arming the write gate. The fixture admits one real Pending to Worker;
+// it does not exercise Producer::send or SASL/TLS.
+async fn negotiated_single_wire_record() -> PreparationFixture {
+    use tokio::io::AsyncWriteExt;
+
+    let mut fixture = preparation_fixture_with_settings(Topology::One, false, false, 1, None).await;
+    let mut pending = fixture.worker.take_all_pending();
+    let first = pending.remove(0);
+    fail_pendings(&fixture.shared, pending, Error::Closed);
+    fixture.worker.push_pending(first);
+    assert_eq!(fixture.shared.buffered_bytes.load(Ordering::SeqCst), 1);
+
+    let worker = &mut fixture.worker;
+    let peer = &mut fixture.peer;
+    let (versions, ()) = tokio::time::timeout(Duration::from_secs(5), async {
+        tokio::join!(
+            crate::protocol::api::negotiate_api_versions(&mut worker.conn, Duration::from_secs(5)),
+            async {
+                let size = peer.read_i32().await.unwrap();
+                assert!((8..=4096).contains(&size));
+                let mut request = vec![0; usize::try_from(size).unwrap()];
+                let _read = peer.read_exact(&mut request).await.unwrap();
+                assert_eq!(
+                    i16::from_be_bytes(request[0..2].try_into().unwrap()),
+                    crate::protocol::api_keys::API_VERSIONS
+                );
+                assert_eq!(i16::from_be_bytes(request[2..4].try_into().unwrap()), 4);
+                let keys = [
+                    ApiVersion {
+                        api_key: crate::protocol::api_keys::API_VERSIONS,
+                        min_version: 0,
+                        max_version: 4,
+                    },
+                    ApiVersion {
+                        api_key: PRODUCE,
+                        min_version: 3,
+                        max_version: 3,
+                    },
+                ];
+                let mut body = BytesMut::new();
+                crate::protocol::api::encode_api_versions_response(
+                    &mut body,
+                    4,
+                    &known_api_versions(&keys),
+                )
+                .unwrap();
+                peer.write_i32(i32::try_from(4 + body.len()).unwrap())
+                    .await
+                    .unwrap();
+                peer.write_all(&request[4..8]).await.unwrap();
+                peer.write_all(&body).await.unwrap();
+            },
+        )
+    })
+    .await
+    .expect("negotiation fixture timed out");
+    let versions = versions.expect("ApiVersions failed");
+    configure_produce_conn(&mut worker.conn, &versions, &fixture.shared.cfg, false);
+    assert_eq!(worker.conn.produce_version(), 3);
+    assert_eq!(worker.conn.in_flight(), 0);
+    assert!(worker.in_flight.is_empty());
+    fixture
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn actual_worker_cancelled_after_real_tcp_prefix_keeps_its_preparing_record() {
+    let mut fixture = negotiated_single_wire_record().await;
+    let gate = tokio::time::timeout(
+        Duration::from_secs(5),
+        fixture.worker.conn.test_gate_tcp_writes(8),
+    )
+    .await
+    .expect("TCP write gate could not be installed");
+    let mut fire = Box::pin(fixture.worker.fire());
+    tokio::time::timeout(Duration::from_secs(5), async {
+        tokio::select! {
+            _ = gate.reached() => {}
+            result = &mut fire => panic!("Produce finished before the prefix gate: {result:?}"),
+        }
+    })
+    .await
+    .expect("real TCP prefix was not written");
+    let mut prefix = [0u8; 8];
+    let _read = tokio::time::timeout(Duration::from_secs(5), fixture.peer.read_exact(&mut prefix))
+        .await
+        .expect("peer did not read the prefix")
+        .unwrap();
+    let size = i32::from_be_bytes(prefix[..4].try_into().unwrap());
+    assert!(size > 4, "the frame was not partial");
+    assert_eq!(
+        i16::from_be_bytes(prefix[4..6].try_into().unwrap()),
+        PRODUCE
+    );
+    assert_eq!(i16::from_be_bytes(prefix[6..8].try_into().unwrap()), 3);
+    assert_eq!(gate.written(), prefix.len());
+    assert!(poll_preparation(fire.as_mut()).await.is_pending());
+    let mut extra = [0u8; 1];
+    assert!(matches!(
+        fixture.peer.try_read(&mut extra),
+        Err(error) if error.kind() == std::io::ErrorKind::WouldBlock
+    ));
+    drop(fire);
+    assert!(fixture.worker.conn.is_closed());
+    assert_eq!(fixture.worker.conn.in_flight(), 0);
+    assert!(fixture.worker.in_flight.is_empty());
+    assert!(fixture.worker.preparing.write_started);
+    assert_eq!(
+        fixture
+            .worker
+            .preparing
+            .retained_records(&fixture.worker.group_scratch),
+        1
+    );
+    gate.release();
+    fixture.shared.closed.store(true, Ordering::SeqCst);
+    drop(fixture.worker);
+    tokio::time::timeout(Duration::from_secs(5), async {
+        let mut outcomes = fixture.outcomes.into_iter();
+        assert!(matches!(
+            outcomes.next().unwrap().await,
+            Ok(Err(Error::Timeout))
+        ));
+        for outcome in outcomes {
+            assert!(matches!(outcome.await, Ok(Err(Error::Closed))));
+        }
+    })
+    .await
+    .expect("cancelled record outcomes did not finish");
+    assert_eq!(fixture.shared.buffered_bytes.load(Ordering::SeqCst), 0);
+    assert_eq!(fixture.shared.live_workers.load(Ordering::SeqCst), 0);
+    drop(fixture.handle);
+    drop(fixture.peer);
+}
