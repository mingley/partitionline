+#[tokio::test(flavor = "current_thread")]
+async fn actual_worker_full_write_tracks_response_outside_connection_counter() {
+    use tokio::io::AsyncWriteExt;
+
+    let mut fixture = negotiated_single_wire_record().await;
+    let worker = &mut fixture.worker;
+    let peer = &mut fixture.peer;
+    let (result, frame) = tokio::time::timeout(Duration::from_secs(5), async {
+        tokio::join!(worker.fire(), async {
+            let size = peer.read_i32().await.unwrap();
+            assert!((8..=1024 * 1024).contains(&size));
+            let mut request = vec![0; usize::try_from(size).unwrap()];
+            let _read = peer.read_exact(&mut request).await.unwrap();
+            request
+        })
+    })
+    .await
+    .expect("Produce frame was not fully written");
+    result.expect("Worker::fire failed");
+    assert_eq!(i16::from_be_bytes(frame[0..2].try_into().unwrap()), PRODUCE);
+    assert_eq!(i16::from_be_bytes(frame[2..4].try_into().unwrap()), 3);
+    let correlation = i32::from_be_bytes(frame[4..8].try_into().unwrap());
+    assert_eq!(worker.in_flight.len(), 1);
+    assert_eq!(worker.in_flight.front().unwrap().correlation, correlation);
+    assert_eq!(worker.conn.in_flight(), 0);
+    assert!(!worker.conn.has_queued_response());
+    assert!(worker.preparing.write_started);
+
+    let mut body = BytesMut::new();
+    body.put_i32(1);
+    crate::protocol::buf::put_string(&mut body, false, Some("orders")).unwrap();
+    body.put_i32(1);
+    body.put_i32(0);
+    body.put_i16(0);
+    body.put_i64(100);
+    body.put_i64(RecordBatch::NO_TIMESTAMP);
+    body.put_i32(0);
+    tokio::time::timeout(Duration::from_secs(5), async {
+        peer.write_i32(i32::try_from(4 + body.len()).unwrap())
+            .await
+            .unwrap();
+        peer.write_i32(correlation).await.unwrap();
+        peer.write_all(&body).await.unwrap();
+    })
+    .await
+    .expect("peer could not send the Produce response");
+    tokio::time::timeout(Duration::from_secs(5), worker.wait_one())
+        .await
+        .expect("matching Produce response was not consumed")
+        .expect("matching Produce response failed");
+    assert!(worker.in_flight.is_empty());
+    assert_eq!(worker.conn.in_flight(), 0);
+    assert_eq!(fixture.shared.buffered_bytes.load(Ordering::SeqCst), 0);
+    tokio::time::timeout(Duration::from_secs(5), async {
+        let mut outcomes = fixture.outcomes.into_iter();
+        assert_eq!(outcomes.next().unwrap().await.unwrap().unwrap().offset, 100);
+        for outcome in outcomes {
+            assert!(matches!(outcome.await, Ok(Err(Error::Closed))));
+        }
+    })
+    .await
+    .expect("acknowledged record outcomes did not finish");
+    fixture.shared.closed.store(true, Ordering::SeqCst);
+    drop(fixture.worker);
+    assert_eq!(fixture.shared.live_workers.load(Ordering::SeqCst), 0);
+    drop(fixture.handle);
+    drop(fixture.peer);
+}
