+    #[tokio::test(flavor = "current_thread")]
+    async fn flexible_tags_must_be_complete_and_strictly_ordered() {
+        let expected = expected().await;
+        let make = |tags: &[u8]| {
+            let mut body = BytesMut::new();
+            body.put_i32(0);
+            crate::protocol::buf::put_array_len(&mut body, true, Some(2)).unwrap();
+            crate::protocol::buf::put_string(&mut body, true, Some("a")).unwrap();
+            crate::protocol::buf::put_array_len(&mut body, true, Some(2)).unwrap();
+            body.put_i32(0);
+            body.put_i16(0);
+            body.extend_from_slice(tags);
+            body.put_i32(1);
+            body.put_i16(0);
+            body.put_u8(0); // second partition tags
+            body.put_u8(0); // topic tags
+            crate::protocol::buf::put_string(&mut body, true, Some("b")).unwrap();
+            crate::protocol::buf::put_array_len(&mut body, true, Some(1)).unwrap();
+            body.put_i32(7);
+            body.put_i16(0);
+            body.put_u8(0); // partition tags
+            body.put_u8(0); // topic tags
+            body.put_u8(0); // response tags
+            body
+        };
+        let accepted = make(&[2, 1, 0, 3, 1, 8]);
+        assert_eq!(
+            validate_add_partitions_response(&accepted, 3, &expected, true, |_| {})
+                .await
+                .unwrap(),
+            0
+        );
+        // Duplicate or descending tags are invalid even when their payloads fit.
+        for tags in [&[2, 3, 0, 3, 0][..], &[2, 3, 0, 1, 0][..]] {
+            let body = make(tags);
+            assert!(
+                validate_add_partitions_response(&body, 3, &expected, true, |_| {})
+                    .await
+                    .is_err()
+            );
+        }
+        let mut truncated = accepted.clone();
+        truncated.truncate(truncated.len() - 1);
+        assert!(
+            validate_add_partitions_response(&truncated, 3, &expected, true, |_| {})
+                .await
+                .is_err()
+        );
+    }
