+    #[tokio::test(flavor = "current_thread")]
+    async fn worker_handles_mixed_fence_missing_and_success() {
+        for kind in 0..5 {
+            tokio::time::timeout(Duration::from_secs(5), async {
+                let (worker, mut peer, _meta_peer) = test_worker().await;
+                let groups = vec![
+                    (Arc::from("a"), 0, Vec::new()),
+                    (Arc::from("a"), 1, Vec::new()),
+                ];
+                let server = async {
+                    match kind {
+                        0 => {
+                            respond(
+                                &mut peer,
+                                &[
+                                    (0, error::COORDINATOR_LOAD_IN_PROGRESS),
+                                    (1, error::PRODUCER_FENCED),
+                                ],
+                            )
+                            .await
+                        }
+                        1 => respond(&mut peer, &[(0, 0)]).await,
+                        2 => respond(&mut peer, &[(1, 0), (0, 0)]).await,
+                        3 => {
+                            respond(
+                                &mut peer,
+                                &[
+                                    (0, error::CONCURRENT_TRANSACTIONS),
+                                    (1, error::NOT_COORDINATOR),
+                                ],
+                            )
+                            .await
+                        }
+                        _ => {
+                            respond(
+                                &mut peer,
+                                &[
+                                    (0, error::NOT_COORDINATOR),
+                                    (1, error::CONCURRENT_TRANSACTIONS),
+                                ],
+                            )
+                            .await
+                        }
+                    }
+                };
+                let (result, ()) = tokio::join!(worker.add_txn_partitions(&groups), server);
+                match kind {
+                    0 => assert_eq!(
+                        result.unwrap_err().broker_code(),
+                        Some(error::PRODUCER_FENCED)
+                    ),
+                    1 => assert!(matches!(result, Err(Error::Protocol(_)))),
+                    2 => assert!(result.is_ok()),
+                    // The fixture intentionally has no FindCoordinator range.
+                    // Unsupported proves txn_roundtrip requested rediscovery.
+                    _ => assert!(matches!(result, Err(Error::Unsupported(_)))),
+                }
+                assert_eq!(worker.shared.txn_fatal.load(Ordering::SeqCst), kind <= 1);
+                let added = worker.shared.txn_added.lock();
+                if kind == 2 {
+                    let parts = added.get("a").unwrap();
+                    assert_eq!(parts.len(), 2);
+                    assert!(parts.contains(&0) && parts.contains(&1));
+                } else {
+                    assert!(added.is_empty());
+                }
+            })
+            .await
+            .expect("worker exchange timed out");
+        }
+    }
