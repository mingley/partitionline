+    #[tokio::test(flavor = "current_thread")]
+    async fn worker_retries_noncoordinator_response_then_sees_fence_or_success() {
+        for fence in [false, true] {
+            tokio::time::timeout(Duration::from_secs(5), async {
+                let (worker, mut peer, _meta_peer) = test_worker().await;
+                let groups = vec![
+                    (Arc::from("a"), 0, Vec::new()),
+                    (Arc::from("a"), 1, Vec::new()),
+                ];
+                let server = async {
+                    respond(
+                        &mut peer,
+                        &[
+                            (0, error::CONCURRENT_TRANSACTIONS),
+                            (1, error::OPERATION_NOT_ATTEMPTED),
+                        ],
+                    )
+                    .await;
+                    if fence {
+                        respond(
+                            &mut peer,
+                            &[
+                                (0, error::COORDINATOR_LOAD_IN_PROGRESS),
+                                (1, error::PRODUCER_FENCED),
+                            ],
+                        )
+                        .await;
+                    } else {
+                        respond(&mut peer, &[(1, 0), (0, 0)]).await;
+                    }
+                };
+                let (result, ()) = tokio::join!(worker.add_txn_partitions(&groups), server);
+                if fence {
+                    assert_eq!(
+                        result.unwrap_err().broker_code(),
+                        Some(error::PRODUCER_FENCED)
+                    );
+                    assert!(worker.shared.txn_fatal.load(Ordering::SeqCst));
+                    assert!(worker.shared.txn_added.lock().is_empty());
+                } else {
+                    result.unwrap();
+                    assert!(!worker.shared.txn_fatal.load(Ordering::SeqCst));
+                    assert_eq!(worker.shared.txn_added.lock().get("a").unwrap().len(), 2);
+                }
+            })
+            .await
+            .expect("worker retry exchange timed out");
+        }
+    }
