+// A broker response must account for exactly the partitions in the request.
+// Index only request identities, so broker-provided counts cannot determine
+// allocation sizes. Each partition has a slot in the response seen bitmap.
+struct AddPartitionsExpectedTopic {
+    slot: usize,
+    partitions: HashMap<i32, usize>,
+}
+
+struct AddPartitionsExpected {
+    topics: HashMap<Arc<str>, AddPartitionsExpectedTopic>,
+    partition_count: usize,
+    max_topic_len: usize,
+}
+
+async fn index_add_partitions_request(added: &[(Arc<str>, i32)]) -> Result<AddPartitionsExpected> {
+    let mut expected = AddPartitionsExpected {
+        topics: HashMap::new(),
+        partition_count: 0,
+        max_topic_len: 0,
+    };
+    let mut walked = 0usize;
+    for (topic, partition) in added {
+        expected.max_topic_len = expected.max_topic_len.max(topic.len());
+        if *partition < 0 {
+            return Err(Error::protocol(
+                "negative AddPartitionsToTxn request partition",
+            ));
+        }
+        if !expected.topics.contains_key(topic.as_ref()) {
+            expected.topics.try_reserve(1).map_err(|_| {
+                Error::protocol("AddPartitionsToTxn request index allocation failed")
+            })?;
+            let slot = expected.topics.len();
+            let _previous = expected.topics.insert(
+                Arc::clone(topic),
+                AddPartitionsExpectedTopic {
+                    slot,
+                    partitions: HashMap::new(),
+                },
+            );
+        }
+        let topic = expected
+            .topics
+            .get_mut(topic.as_ref())
+            .ok_or_else(|| Error::protocol("AddPartitionsToTxn request index is inconsistent"))?;
+        topic
+            .partitions
+            .try_reserve(1)
+            .map_err(|_| Error::protocol("AddPartitionsToTxn request index allocation failed"))?;
+        if topic
+            .partitions
+            .insert(*partition, expected.partition_count)
+            .is_some()
+        {
+            return Err(Error::protocol(
+                "duplicate AddPartitionsToTxn request partition",
+            ));
+        }
+        expected.partition_count = expected
+            .partition_count
+            .checked_add(1)
+            .ok_or_else(|| Error::protocol("too many AddPartitionsToTxn request partitions"))?;
+        walked += 1;
+        if walked == 8 * 1024 {
+            walked = 0;
+            tokio::task::yield_now().await;
+        }
+    }
+    Ok(expected)
+}
+
+fn get_add_partitions_topic<'a>(
+    input: &mut &'a [u8],
+    flexible: bool,
+    max_topic_len: usize,
+) -> Result<&'a str> {
+    let length = if flexible {
+        let encoded = crate::protocol::buf::get_unsigned_varint(input)?;
+        if encoded == 0 {
+            return Err(Error::protocol("null AddPartitionsToTxn response topic"));
+        }
+        usize::try_from(encoded - 1)
+            .map_err(|_| Error::protocol("AddPartitionsToTxn topic length overflow"))?
+    } else {
+        let length = crate::protocol::buf::get_i16(input)?;
+        usize::try_from(length)
+            .map_err(|_| Error::protocol("null AddPartitionsToTxn response topic"))?
+    };
+    if length > max_topic_len {
+        return Err(Error::protocol(
+            "unrequested AddPartitionsToTxn response topic length",
+        ));
+    }
+    let (name, rest) = (*input)
+        .split_at_checked(length)
+        .ok_or_else(|| Error::protocol("truncated AddPartitionsToTxn response topic"))?;
+    *input = rest;
+    std::str::from_utf8(name)
+        .map_err(|_| Error::protocol("invalid UTF-8 AddPartitionsToTxn response topic"))
+}
+
+// Unknown flexible tags are skipped without allocation. Bound work to bytes
+// present and yield even if the peer sends many small tagged fields.
+async fn skip_add_partitions_tags(input: &mut &[u8], walked: &mut usize) -> Result<()> {
+    let count = usize::try_from(crate::protocol::buf::get_unsigned_varint(input)?)
+        .map_err(|_| Error::protocol("AddPartitionsToTxn tag count overflow"))?;
+    if count > input.len() / 2 {
+        return Err(Error::protocol(
+            "AddPartitionsToTxn tag count exceeds response",
+        ));
+    }
+    let mut previous = None;
+    for _ in 0..count {
+        let tag = crate::protocol::buf::get_unsigned_varint(input)?;
+        if previous.is_some_and(|value| tag <= value) {
+            return Err(Error::protocol("AddPartitionsToTxn tags are not ordered"));
+        }
+        previous = Some(tag);
+        let size = usize::try_from(crate::protocol::buf::get_unsigned_varint(input)?)
+            .map_err(|_| Error::protocol("AddPartitionsToTxn tag size overflow"))?;
+        let (_, rest) = (*input)
+            .split_at_checked(size)
+            .ok_or_else(|| Error::protocol("truncated AddPartitionsToTxn tag"))?;
+        *input = rest;
+        *walked += 1;
+        if *walked == 8 * 1024 {
+            *walked = 0;
+            tokio::task::yield_now().await;
+        }
+    }
+    Ok(())
+}
+
+// Prefer a moved/unavailable coordinator over same-session retry causes.
+// Main's txn_roundtrip also rediscovers for LOAD; the relative order here
+// preserves a stronger moved-coordinator signal for a future LOAD-only retry.
+fn add_partitions_retry_priority(code: i16) -> u8 {
+    match code {
+        error::NOT_COORDINATOR => 3,
+        error::COORDINATOR_NOT_AVAILABLE => 2,
+        error::COORDINATOR_LOAD_IN_PROGRESS => 1,
+        _ => 0,
+    }
+}
+
+async fn validate_add_partitions_response<F: FnMut(i16)>(
+    mut input: &[u8],
+    version: i16,
+    expected: &AddPartitionsExpected,
+    can_handle_abortable: bool,
+    mut on_fatal: F,
+) -> Result<i16> {
+    let flexible = match version {
+        0..=2 => false,
+        3 => true,
+        _ => {
+            return Err(Error::protocol(
+                "unsupported AddPartitionsToTxn response version",
+            ))
+        }
+    };
+    let _throttle = crate::protocol::buf::get_i32(&mut input)?;
+    let topic_count = crate::protocol::buf::get_array_len(&mut input, flexible)?
+        .ok_or_else(|| Error::protocol("null AddPartitionsToTxn response topics"))?;
+    if topic_count != expected.topics.len() {
+        return Err(Error::protocol(
+            "AddPartitionsToTxn response topic count mismatch",
+        ));
+    }
+    let mut seen_topics = Vec::new();
+    seen_topics
+        .try_reserve_exact(expected.topics.len())
+        .map_err(|_| Error::protocol("AddPartitionsToTxn response index allocation failed"))?;
+    seen_topics.resize(expected.topics.len(), false);
+    let mut seen_parts = Vec::new();
+    seen_parts
+        .try_reserve_exact(expected.partition_count)
+        .map_err(|_| Error::protocol("AddPartitionsToTxn response index allocation failed"))?;
+    seen_parts.resize(expected.partition_count, false);
+    let mut first_fatal = 0i16;
+    let mut first_abortable = 0i16;
+    let mut first_retriable = 0i16;
+    let mut first_placeholder = 0i16;
+    let mut walked = 0usize;
+    for _ in 0..topic_count {
+        let name = get_add_partitions_topic(&mut input, flexible, expected.max_topic_len)?;
+        let topic = expected
+            .topics
+            .get(name)
+            .ok_or_else(|| Error::protocol("unrequested AddPartitionsToTxn response topic"))?;
+        let seen = seen_topics
+            .get_mut(topic.slot)
+            .ok_or_else(|| Error::protocol("AddPartitionsToTxn topic index is inconsistent"))?;
+        if *seen {
+            return Err(Error::protocol(
+                "duplicate AddPartitionsToTxn response topic",
+            ));
+        }
+        *seen = true;
+        let count = crate::protocol::buf::get_array_len(&mut input, flexible)?
+            .ok_or_else(|| Error::protocol("null AddPartitionsToTxn response partitions"))?;
+        if count != topic.partitions.len() {
+            return Err(Error::protocol(
+                "AddPartitionsToTxn response partition count mismatch",
+            ));
+        }
+        for _ in 0..count {
+            let partition = crate::protocol::buf::get_i32(&mut input)?;
+            let code = crate::protocol::buf::get_i16(&mut input)?;
+            let slot = topic.partitions.get(&partition).ok_or_else(|| {
+                Error::protocol("unrequested AddPartitionsToTxn response partition")
+            })?;
+            let seen = seen_parts.get_mut(*slot).ok_or_else(|| {
+                Error::protocol("AddPartitionsToTxn partition index is inconsistent")
+            })?;
+            if *seen {
+                return Err(Error::protocol(
+                    "duplicate AddPartitionsToTxn response partition",
+                ));
+            }
+            *seen = true;
+            if code != 0 {
+                if code == error::OPERATION_NOT_ATTEMPTED {
+                    first_placeholder = code;
+                } else {
+                    match classify_add_partitions_error(code, can_handle_abortable) {
+                        TxnErrorDisposition::Fatal if first_fatal == 0 => {
+                            // Record a matched fatal result before any subsequent yield.
+                            first_fatal = code;
+                            on_fatal(code);
+                        }
+                        TxnErrorDisposition::Abortable if first_abortable == 0 => {
+                            first_abortable = code;
+                        }
+                        TxnErrorDisposition::Retriable => {
+                            let priority = add_partitions_retry_priority(code);
+                            let old_priority = add_partitions_retry_priority(first_retriable);
+                            if first_retriable == 0
+                                || priority > old_priority
+                                || (priority == old_priority && code < first_retriable)
+                            {
+                                first_retriable = code;
+                            }
+                        }
+                        _ => {}
+                    }
+                }
+            }
+            if flexible {
+                skip_add_partitions_tags(&mut input, &mut walked).await?;
+            }
+            walked += 1;
+            if walked == 8 * 1024 {
+                walked = 0;
+                tokio::task::yield_now().await;
+            }
+        }
+        if flexible {
+            skip_add_partitions_tags(&mut input, &mut walked).await?;
+        }
+        walked += 1;
+        if walked == 8 * 1024 {
+            walked = 0;
+            tokio::task::yield_now().await;
+        }
+    }
+    if flexible {
+        skip_add_partitions_tags(&mut input, &mut walked).await?;
+    }
+    if !input.is_empty() {
+        return Err(Error::protocol(
+            "trailing AddPartitionsToTxn response bytes",
+        ));
+    }
+    // OPERATION_NOT_ATTEMPTED is a consequence of another partition's error.
+    // Prefer the decisive error, and require abort rather than retry when a
+    // substantive abortable and a retriable error occur together.
+    Ok(if first_fatal != 0 {
+        first_fatal
+    } else if first_abortable != 0 {
+        first_abortable
+    } else if first_retriable != 0 {
+        first_retriable
+    } else {
+        first_placeholder
+    })
+}
+
+// Once a response has been received, abandoning its validation could hide a
+// fence later in the response. Treat cancellation or malformed coverage as a
+// terminal, ambiguous transaction outcome rather than permitting further use.
+struct AddPartitionsResponseGuard<'a> {
+    shared: &'a Shared,
+    complete: bool,
+}
+
+impl Drop for AddPartitionsResponseGuard<'_> {
+    fn drop(&mut self) {
+        if !self.complete {
+            self.shared.set_txn_fatal(Error::protocol(
+                "AddPartitionsToTxn response invalid or validation cancelled",
+            ));
+        }
+    }
+}
+
+async fn decode_add_partitions_and_record(
+    shared: &Shared,
+    body: &[u8],
+    version: i16,
+    expected: &AddPartitionsExpected,
+) -> Result<i16> {
+    let mut guard = AddPartitionsResponseGuard {
+        shared,
+        complete: false,
+    };
+    let can_handle_abortable = shared.txn_can_handle_abortable();
+    let code =
+        validate_add_partitions_response(body, version, expected, can_handle_abortable, |fatal| {
+            shared.set_txn_fatal(Error::broker(fatal, "AddPartitionsToTxn"))
+        })
+        .await?;
+    if code != 0
+        && classify_add_partitions_error(code, can_handle_abortable)
+            == TxnErrorDisposition::Abortable
+    {
+        shared.set_txn_abortable(Error::broker(code, "AddPartitionsToTxn"));
+    }
+    guard.complete = true;
+    Ok(code)
+}
