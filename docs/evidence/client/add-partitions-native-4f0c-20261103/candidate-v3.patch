+    #[tokio::test(flavor = "current_thread")]
+    async fn dropping_validation_before_later_fence_fails_closed() {
+        for early_fence in [false, true] {
+            let (shared, _listener, _meta_peer) = shared_fixture().await;
+            let request: Vec<_> = (0..8_193)
+                .map(|part| (Arc::<str>::from("a"), part))
+                .collect();
+            let expected = index_add_partitions_request(&request).await.unwrap();
+            let parts: Vec<_> = (0..8_193)
+                .map(|part| {
+                    let is_fence = if early_fence {
+                        part == 0
+                    } else {
+                        part == 8_192
+                    };
+                    (part, if is_fence { error::PRODUCER_FENCED } else { 0 })
+                })
+                .collect();
+            let body = encoded(0, &[topic("a", &parts)]);
+            let mut future = Box::pin(decode_add_partitions_and_record(
+                &shared, &body, 0, &expected,
+            ));
+            assert!(matches!(poll_once(future.as_mut()), Poll::Pending));
+            assert_eq!(shared.txn_fatal.load(Ordering::SeqCst), early_fence);
+            drop(future);
+            assert!(shared.txn_fatal.load(Ordering::SeqCst));
+            let cause = shared.fail_on_txn_fatal().unwrap_err();
+            if early_fence {
+                assert_eq!(cause.broker_code(), Some(error::PRODUCER_FENCED));
+            } else {
+                assert!(matches!(cause, Error::Protocol(_)));
+            }
+        }
+    }
