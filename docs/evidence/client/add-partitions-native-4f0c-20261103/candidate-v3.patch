+                    &null_nested,
+                    version,
+                    &expected,
+                    true,
+                    |_| {}
+                )
+                .await
+                .is_err());
+            }
+            // The wire count is smaller than the remaining bytes, but far larger
+            // than the request. Reject it without allocating from this count.
+            let mut huge_count = BytesMut::new();
+            huge_count.put_i32(0);
+            if version == 3 {
+                crate::protocol::buf::put_unsigned_varint(&mut huge_count, 500_001);
+            } else {
+                huge_count.put_i32(500_000);
+            }
+            huge_count.resize(500_020, 0);
+            assert!(validate_add_partitions_response(
+                &huge_count,
+                version,
+                &expected,
+                true,
+                |_| {}
+            )
+            .await
+            .is_err());
+        }
+    }
