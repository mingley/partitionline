+            api_key,
+            api_version,
+            correlation,
+            Some(self.client_id.as_str()),
+        )?;
+        let frame_len = self
+            .write_buf
+            .len()
+            .saturating_sub(4)
+            .checked_add(body.len())
+            .ok_or_else(|| Error::protocol("request frame length overflow"))?;
+        let size = crate::protocol::buf::i32_from_usize(frame_len)?;
+        let slot = self
+            .write_buf
+            .get_mut(..4)
+            .ok_or_else(|| Error::protocol("short length prefix"))?;
