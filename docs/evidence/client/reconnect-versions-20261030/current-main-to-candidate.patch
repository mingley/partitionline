+        attempts.contains(&1),
+        "the live bootstrap must be attempted: {attempts:?}"
+    );
+    assert!(
+        attempts.contains(&2),
+        "discovery must try the other bootstrap after the live socket closes: {attempts:?}"
+    );
+    assert_eq!(mock.last_leave_group_node(), Some(2));
+}
