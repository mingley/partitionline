+    async fn wait_for_close(mut socket: TcpStream, closed: Arc<AtomicBool>) {
+        let mut bytes = [0u8; 256];
+        while matches!(socket.read(&mut bytes).await, Ok(n) if n > 0) {}
+        closed.store(true, Ordering::SeqCst);
+    }
