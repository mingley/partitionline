+#[tokio::test]
+async fn classic_heartbeat_retries_coordinator_load_on_the_same_socket() {
+    let mock = common::Mock::start_two_node().await;
+    mock.set_topic_partitions("t", 1);
+    mock.set_partition_leader("t", 0, 1);
+    mock.set_coordinator(2);
