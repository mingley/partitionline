+        let addr = listener.local_addr().unwrap().to_string();
+        let mut conn =
+            BrokerConn::connect(&addr, "flush-regression-worker", Duration::from_secs(1))
+                .await
+                .unwrap();
+        let (worker_peer, _) = listener.accept().await.unwrap();
+        conn.set_produce_version(9);
+        let (data, data_rx) = mpsc::channel(8);
+        let (ctrl, ctrl_rx) = mpsc::channel(8);
+        let id = Arc::new(());
+        let admission = Arc::new(WorkerAdmission::for_producer(Arc::clone(&shared.closed)));
+        let worker = Worker {
+            id: Arc::clone(&id),
+            admission: Arc::clone(&admission),
+            node_id: 1,
+            throttle: shared.broker_throttle(1),
+            conn,
+            data: data_rx,
+            ctrl: ctrl_rx,
+            shared: Arc::clone(&shared),
+            write_buf: BytesMut::new(),
+            pending: Vec::new(),
+            spare_batch: Vec::new(),
+            pending_estimate: 0,
+            earliest_deadline: None,
+            in_flight: VecDeque::new(),
+            fail: None,
+            compress_scratch: CompressScratch::default(),
+            group_scratch: ProduceGroupScratch::default(),
+            ack_index: AckIndex::default(),
+            ack_slots: Vec::new(),
+            spare_acks: Vec::new(),
+            ack_requested: HashMap::new(),
+            ack_seen: HashMap::new(),
+            ack_tracker: None,
+            _live: WorkerLease::register(&shared),
+        };
+        let handle = WorkerHandle::new(
+            id,
+            admission,
+            data,
+            ctrl,
+            Arc::new(tokio::spawn(worker.run())),
