+        producer
+            .try_send(ProduceRecord::to("t").partition(0).value("value"))
+            .unwrap();
+        let retired = retire_worker_nudge(&shared, 1, &worker.id).unwrap();
+        assert!(!worker.task.is_finished());
+        assert_eq!(shared.retries_out.load(Ordering::SeqCst), 0);
+        assert_eq!(shared.m_acked.load(Ordering::SeqCst), 0);
+        assert_eq!(shared.m_errors.load(Ordering::SeqCst), 0);
+        assert_eq!(shared.buffered_bytes.load(Ordering::SeqCst), 5);
+
+        let mut flush = Box::pin(producer.flush_timeout(Duration::from_secs(5)));
+        let first_poll = std::future::poll_fn(|cx| {
+            std::task::Poll::Ready(std::future::Future::poll(flush.as_mut(), cx))
+        })
+        .await;
+        drop(flush);
+        drop(retired);
+        assert!(
+            !matches!(first_poll, std::task::Poll::Ready(Ok(()))),
+            "flush reported success before the retired worker processed the record"
+        );
