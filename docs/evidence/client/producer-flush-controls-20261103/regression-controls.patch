+    #[tokio::test(flavor = "current_thread")]
+    async fn flush_reports_an_accepted_record_expiring_in_pending() {
+        let cfg = ProducerConfig::default().delivery_timeout(Duration::ZERO);
+        let (producer, shared, _worker, _meta_peer, _worker_peer) =
+            flush_regression_worker(cfg).await;
+        producer
+            .try_send(ProduceRecord::to("t").partition(0).value("value"))
+            .unwrap();
+
+        let result = tokio::time::timeout(
+            Duration::from_secs(1),
+            producer.flush_timeout(Duration::from_secs(5)),
+        )
+        .await
+        .expect("flush did not finish after the record expired");
+        assert_eq!(shared.m_errors.load(Ordering::SeqCst), 1);
+        assert_eq!(shared.buffered_bytes.load(Ordering::SeqCst), 0);
+        assert!(
+            matches!(result, Err(Error::Timeout)),
+            "flush lost the delivery timeout: {result:?}"
+        );
+    }
