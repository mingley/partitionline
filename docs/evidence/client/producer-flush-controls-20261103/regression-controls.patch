+    #[tokio::test(flavor = "current_thread")]
+    async fn cancelled_flush_cannot_consume_an_unobserved_record_failure() {
+        let cfg = ProducerConfig::default().linger(Duration::from_secs(60));
+        let (producer, shared, _worker, _meta_peer, _worker_peer) =
+            flush_regression_worker(cfg).await;
+        producer.inject_pre_send_fault(PreSendFault::TxnPartition);
+        producer
+            .try_send(ProduceRecord::to("t").partition(0).value("value"))
+            .unwrap();
+
+        // Poll to enqueue the first worker control, then cancel before the
+        // current-thread worker can run and report its injected failure.
+        let mut cancelled = Box::pin(producer.flush_timeout(Duration::from_secs(5)));
+        let first_poll = std::future::poll_fn(|cx| {
+            std::task::Poll::Ready(std::future::Future::poll(cancelled.as_mut(), cx))
+        })
+        .await;
+        assert!(
+            first_poll.is_pending(),
+            "first flush should be waiting for its worker"
+        );
+        drop(cancelled);
+
+        let result = tokio::time::timeout(
+            Duration::from_secs(1),
+            producer.flush_timeout(Duration::from_secs(5)),
+        )
+        .await
+        .expect("second flush did not finish");
+        assert_eq!(shared.m_errors.load(Ordering::SeqCst), 1);
+        assert_eq!(shared.buffered_bytes.load(Ordering::SeqCst), 0);
+        assert!(
+            result.is_err(),
+            "cancelled flush discarded the only failure report"
+        );
+    }
