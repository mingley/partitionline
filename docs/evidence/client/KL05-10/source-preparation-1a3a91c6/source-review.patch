+            .map(|batch| (batch.1, batch.2)),
+        Some((0, 5))
+    );
+    assert_eq!(producer.__test_sticky_state().unwrap().4, charged);
+    assert_eq!(producer.__test_sticky_state().unwrap().1, 0);
+    assert_eq!(producer.metrics().bytes_buffered, 0);
+    producer.close().await.unwrap();
+}
