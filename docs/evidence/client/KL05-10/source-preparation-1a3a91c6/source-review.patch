+fn sticky_partitioner_descriptor_is_additive_and_default_routing_stays_compatible() {
+    use partitionline::partitioner::{
+        DefaultPartitioner, StickyPartitioner, StickyPartitionerConfig,
+    };
+    let default = DefaultPartitioner::new();
+    assert_eq!(default.unkeyed_batching_policy(), None);
+    assert_eq!(default.partition("a", None, 3), 0);
+    assert_eq!(
+        default.partition("b", Some(b""), 3),
+        partition_for_key(b"", 3)
+    );
+    assert_eq!(default.partition("b", None, 3), 1);
+    struct ExistingCustom;
+    impl Partitioner for ExistingCustom {
+        fn partition(&self, _topic: &str, _key: Option<&[u8]>, _partitions: i32) -> i32 {
+            2
+        }
+    }
+    let custom: Box<dyn Partitioner> = Box::new(ExistingCustom);
+    assert_eq!(custom.unkeyed_batching_policy(), None);
+    assert_eq!(custom.partition("t", None, 3), 2);
+    let sticky: Box<dyn Partitioner> = Box::new(StickyPartitioner::seeded(73));
+    assert_eq!(
+        sticky.unkeyed_batching_policy(),
+        Some(StickyPartitionerConfig {
+            seed: Some(73),
+            ..StickyPartitionerConfig::default()
+        })
+    );
+    assert_eq!(
+        sticky.partition("t", Some(b"key"), 3),
+        partition_for_key(b"key", 3)
+    );
+}
