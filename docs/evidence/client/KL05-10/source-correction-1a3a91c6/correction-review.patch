+        let first = state.route(&topic, &cluster).unwrap();
+        let mut plan = state.plan(&topic, first.partition, &worker, 100, &cluster);
+        plan.next_rng = first.rng;
+        state.commit(&topic, first.partition, &worker, true, plan, &cluster);
+        let rng = state.rng;
