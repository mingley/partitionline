        "has_key_name_in_catalog": true,
        "has_wire_helper": false,
        "has_runtime_operation": false,
        "reason": "Public Streams group description/client operation remains missing; Java framework exclusion does not cover API89"
      }
    ],
    "missing_features": [
      {
        "feature_id": "producer.sticky_partitioner",
        "profile": "producer",
        "disposition": "missing",
        "notes": "Opt-in sticky unkeyed batching partitioner is not implemented; tracked in KL05-10."
      },
      {
        "feature_id": "codecs.zstd.decode",
        "profile": "codecs",
        "disposition": "missing",
        "notes": "Compression ID 4 decoding is unsupported in src/protocol/records.rs. Explicit missing feature of complete codec profile (KL05-02, KL05-03)."
      },
      {
        "feature_id": "codecs.zstd.encode",
        "profile": "codecs",
        "disposition": "missing",
        "notes": "Zstd encoding is not implemented; deny.toml bans zstd-sys. Explicit missing feature of complete codec profile (KL05-02, KL05-04)."
      },
      {
        "feature_id": "auth.sasl_oidc_refresh",
        "profile": "auth",
        "disposition": "missing",
        "notes": "Proactive token refresh before expiry and broker session_lifetime_ms reauth are missing; tracked in KL06-01 to KL06-04."
      },
      {
        "feature_id": "auth.sasl_gssapi",
        "profile": "auth",
        "disposition": "missing",
        "notes": "Kerberos GSSAPI authentication is not implemented (requires Cyrus SASL C library). Explicit missing feature of enterprise auth profile (KL06-08 to KL06-10)."
      },
      {
        "feature_id": "schema_ecosystem.avro",
        "profile": "schema ecosystem",
        "disposition": "missing",
        "notes": "Opt-in Avro serialization/deserialization adapter; companion crate, tracked in KL05-25."
      },
      {
        "feature_id": "schema_ecosystem.json_schema",
        "profile": "schema ecosystem",
        "disposition": "missing",
        "notes": "JSON Schema validation and serialization adapter; companion crate, tracked in KL05-27."
      }
    ],
    "partial_features": [
      {
        "feature_id": "producer.buffer_memory",
        "profile": "producer",
        "disposition": "partial",
        "notes": "Caps queued key+value bytes; partial because headers, metadata, encoded buffers, and socket memory are uncounted (audit A08)."
      },
      {
        "feature_id": "group.kip848_heartbeat_scheduling",
        "profile": "group",
        "disposition": "partial",
        "notes": "Partial because heartbeat loop uses fixed 150ms interval rather than broker response interval (audit A07, KL03-12)."
      }
    ]
  },
