##[start-action display=rustup toolchain install stable;id=__dtolnay_rust-toolchain.__run_4]
##[group]Run set -f  # split targets and components on commas and whitespace, without glob expansion
set -f  # split targets and components on commas and whitespace, without glob expansion
flags=()
for t in ${targets//,/ }; do flags+=(--target "$t"); done
for c in ${components//,/ }; do flags+=(--component "$c"); done
if [[ $toolchain == nightly && -n $components ]]; then flags+=(--allow-downgrade); fi
log=$(mktemp)
trap 'rm -f "$log"' EXIT
for attempt in 1 2 3 4 5; do
  if rustup toolchain install "$toolchain" "${flags[@]}" --profile minimal --no-self-update --force-non-host 2>&1 | tee "$log"; then
    break
  else
    status=$?
  fi
  if [[ $attempt == 5 ]] || ! grep -Fq 'checksum failed for ' "$log" \
      || ! grep -Fq 'this is likely due to an ongoing update of the official release server' "$log"; then
    exit "$status"
  fi
  echo "Retrying rustup toolchain install in 30 seconds (retry $attempt of 4)" >&2
  sleep 30
done
