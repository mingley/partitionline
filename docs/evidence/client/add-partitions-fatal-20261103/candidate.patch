+            f.shared.in_txn.store(true, Ordering::SeqCst);
+            f.shared.producer_id.store(9, Ordering::SeqCst);
+            f.shared.producer_epoch.store(2, Ordering::SeqCst);
+            f.worker.conn.set_produce_version(3);
+            let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+            let addr = listener.local_addr().unwrap().to_string();
+            let conn = BrokerConn::connect(&addr, "add-partitions-test", Duration::from_secs(2))
+                .await
+                .unwrap();
+            let (mut peer, _) = tokio::time::timeout(Duration::from_secs(2), listener.accept())
+                .await
+                .unwrap()
+                .unwrap();
+            let versions = ApiVersionsResponse {
+                api_keys: vec![ApiVersion {
+                    api_key: ADD_PARTITIONS_TO_TXN,
+                    min_version: 0,
+                    max_version: 0,
+                }],
+                ..Default::default()
+            };
+            *f.shared.txn.lock().await = Some(coordinator_connection(conn, &versions));
+            let groups = vec![
+                (Arc::<str>::from("orders"), 0, Vec::new()),
+                (Arc::<str>::from("orders"), 1, Vec::new()),
+            ];
+            let server = async {
+                let mut size = [0u8; 4];
+                let _size = peer.read_exact(&mut size).await.unwrap();
+                let len = usize::try_from(i32::from_be_bytes(size)).unwrap();
+                assert!((8..=4096).contains(&len));
+                let mut frame = vec![0u8; len];
+                let _frame = peer.read_exact(&mut frame).await.unwrap();
+                let mut request = frame.as_slice();
+                let header = decode_request_header(&mut request).unwrap();
+                assert_eq!(header.api_key, ADD_PARTITIONS_TO_TXN);
+                assert_eq!(header.api_version, 0);
+                let (tid, pid, epoch, topics) =
+                    decode_add_partitions_to_txn_request(&mut request, 0).unwrap();
+                assert_eq!(tid, "prepare-owner-transaction");
+                assert_eq!((pid, epoch), (9, 2));
+                assert!(request.is_empty());
+                assert_eq!(topics.len(), 1);
+                let topic = topics.first().unwrap();
+                assert_eq!(topic.topic, "orders");
+                assert_eq!(topic.partitions.len(), 2);
+                assert!(topic.partitions.contains(&0) && topic.partitions.contains(&1));
+                let errors = if fenced_first {
+                    [error::PRODUCER_FENCED, error::COORDINATOR_LOAD_IN_PROGRESS]
