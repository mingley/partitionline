+// The producer must see a fatal partition even when another partition came
+// first. The public first-error decoder remains a separate compatibility API.
+#[tokio::test(flavor = "current_thread")]
+async fn add_partitions_fatal_precedence_validates_all_spoken_versions() {
+    use crate::protocol::txn::{
+        decode_add_partitions_to_txn_response, encode_add_partitions_to_txn_topics_response,
+        AddPartitionsToTxnPartitionResult, AddPartitionsToTxnTopicResult,
+    };
+    let cases = [
+        (
+            [error::COORDINATOR_LOAD_IN_PROGRESS, error::PRODUCER_FENCED],
+            true,
+            error::PRODUCER_FENCED,
+        ),
+        (
+            [error::PRODUCER_FENCED, error::COORDINATOR_LOAD_IN_PROGRESS],
+            true,
+            error::PRODUCER_FENCED,
+        ),
+        (
+            [
+                error::TOPIC_AUTHORIZATION_FAILED,
+                error::INVALID_PRODUCER_EPOCH,
+            ],
+            true,
+            error::INVALID_PRODUCER_EPOCH,
+        ),
+        (
+            [
+                error::COORDINATOR_LOAD_IN_PROGRESS,
+                error::UNKNOWN_PRODUCER_ID,
+            ],
+            false,
+            error::UNKNOWN_PRODUCER_ID,
+        ),
+        (
+            [
+                error::COORDINATOR_LOAD_IN_PROGRESS,
+                error::UNKNOWN_PRODUCER_ID,
+            ],
+            true,
+            error::COORDINATOR_LOAD_IN_PROGRESS,
+        ),
+        (
+            [
+                error::CONCURRENT_TRANSACTIONS,
+                error::OPERATION_NOT_ATTEMPTED,
+            ],
+            true,
+            error::CONCURRENT_TRANSACTIONS,
+        ),
+        (
+            [
+                error::OPERATION_NOT_ATTEMPTED,
+                error::CONCURRENT_TRANSACTIONS,
+            ],
+            true,
+            error::OPERATION_NOT_ATTEMPTED,
+        ),
+        (
+            [i16::MAX, error::COORDINATOR_LOAD_IN_PROGRESS],
+            true,
+            i16::MAX,
+        ),
+        ([0, error::PRODUCER_FENCED], true, error::PRODUCER_FENCED),
+        ([0, 0], true, 0),
+    ];
+    for version in 0..=3 {
+        for (codes, can_handle, expected) in cases {
+            let topics: Vec<_> = codes
+                .iter()
+                .enumerate()
+                .map(|(index, code)| AddPartitionsToTxnTopicResult {
+                    topic: format!("t{index}"),
+                    partitions: vec![AddPartitionsToTxnPartitionResult::error(0, *code)],
+                })
+                .collect();
+            let mut encoded = BytesMut::new();
+            encode_add_partitions_to_txn_topics_response(&mut encoded, version, &topics).unwrap();
+            let public_first =
+                decode_add_partitions_to_txn_response(&mut encoded.as_ref(), version).unwrap();
+            assert_eq!(
+                public_first,
+                codes.iter().copied().find(|code| *code != 0).unwrap_or(0)
+            );
+            let mut input = encoded.as_ref();
+            assert_eq!(
+                decode_add_partitions_producer_error(&mut input, version, can_handle, |_| {})
+                    .await
+                    .unwrap(),
+                expected
+            );
+            assert!(input.is_empty());
+            let mut truncated = encoded.clone();
+            truncated.truncate(truncated.len().saturating_sub(1));
+            assert!(decode_add_partitions_producer_error(
+                &mut truncated.as_ref(),
+                version,
+                can_handle,
+                |_| {},
+            )
+            .await
+            .is_err());
+            let mut extended = encoded.clone();
+            extended.extend_from_slice(&[0]);
+            assert!(decode_add_partitions_producer_error(
+                &mut extended.as_ref(),
+                version,
+                can_handle,
+                |_| {},
+            )
+            .await
+            .is_err());
+        }
+    }
+}
