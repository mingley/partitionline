+                    [0, 0]
+                };
+                let second = respond(&mut peer, errors).await;
+                assert_ne!(first, second);
+            };
+            let (result, ()) = tokio::time::timeout(Duration::from_secs(3), async {
+                tokio::join!(f.worker.add_txn_partitions(&groups), server)
+            })
+            .await
+            .expect("add-partitions retry exchange did not complete");
+            if fence {
+                assert_eq!(
+                    result.unwrap_err().broker_code(),
+                    Some(error::PRODUCER_FENCED)
+                );
+                assert!(f.shared.txn_fatal.load(Ordering::SeqCst));
+                assert!(f.shared.txn_added.lock().is_empty());
+            } else {
+                result.unwrap();
+                assert!(!f.shared.txn_fatal.load(Ordering::SeqCst));
+                let added = f.shared.txn_added.lock();
+                let partitions = added.get("orders").unwrap();
+                assert_eq!(partitions.len(), 2);
+                assert!(partitions.contains(&0) && partitions.contains(&1));
+            }
+            f.shared.closed.store(true, Ordering::SeqCst);
+            drop(f);
+        })
+        .await
+        .expect("add-partitions retry fixture did not finish");
+    }
+}
+
+// Once structural decoding has finished, cancelling during the reducer's
+// cooperative scan must not erase a fatal code that the scan has observed.
+#[tokio::test(flavor = "current_thread")]
+async fn cancelled_add_partitions_scan_keeps_observed_fence() {
+    use crate::protocol::txn::{
+        encode_add_partitions_to_txn_topics_response, AddPartitionsToTxnPartitionResult,
+        AddPartitionsToTxnTopicResult,
+    };
+    tokio::time::timeout(Duration::from_secs(8), async {
+        let f =
+            preparation_fixture_with_settings(Topology::One, false, true, PREPARING_COUNT, None)
+                .await;
+        f.shared.in_txn.store(true, Ordering::SeqCst);
+        let response = [AddPartitionsToTxnTopicResult {
+            topic: "orders".to_owned(),
+            partitions: (0..PREPARING_COUNT)
+                .map(|index| {
+                    let code = if index == 0 {
+                        error::PRODUCER_FENCED
+                    } else {
+                        0
+                    };
+                    AddPartitionsToTxnPartitionResult::error(i32::try_from(index).unwrap(), code)
+                })
+                .collect(),
+        }];
+        let mut encoded = BytesMut::new();
+        encode_add_partitions_to_txn_topics_response(&mut encoded, 0, &response).unwrap();
+        let mut input = encoded.as_ref();
+        let mut decode = Box::pin(decode_add_partitions_and_record_fatal(
+            &f.shared, &mut input, 0, false,
+        ));
+        // The parser yields after 8,192 results, before it can validate the
+        // full body. The producer cannot yet publish a decoded fatal result.
+        assert!(matches!(
+            poll_preparation(decode.as_mut()).await,
+            Poll::Pending
+        ));
+        assert!(!f.shared.txn_fatal.load(Ordering::SeqCst));
+        // Parsing finishes; the subsequent scan observes the first fence and
+        // then yields at 8,192. Drop it at that actual cooperative boundary.
+        assert!(matches!(
+            poll_preparation(decode.as_mut()).await,
+            Poll::Pending
+        ));
+        assert!(f.shared.txn_fatal.load(Ordering::SeqCst));
+        drop(decode);
+        assert_eq!(
+            f.shared.fail_on_txn_fatal().unwrap_err().broker_code(),
+            Some(error::PRODUCER_FENCED)
+        );
+        f.shared.closed.store(true, Ordering::SeqCst);
+        drop(f);
+    })
+    .await
+    .expect("cancelled add-partitions scan fixture did not finish");
+}
