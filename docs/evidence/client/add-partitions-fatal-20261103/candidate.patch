+// Validate the full response before selecting a fatal error. Among nonfatal
+// errors preserve the existing first-error behavior, including retry policy.
+async fn decode_add_partitions_producer_error<F: FnMut(i16)>(
+    body: &mut &[u8],
+    version: i16,
+    can_handle_abortable: bool,
+    mut on_fatal: F,
+) -> Result<i16> {
+    let (topics, _) =
+        decode_add_partitions_to_txn_topics_response_cooperative(body, version).await?;
+    if !body.is_empty() {
+        return Err(Error::protocol(
+            "trailing bytes in AddPartitionsToTxn response",
+        ));
+    }
+    let mut first = 0;
+    let mut first_fatal = 0;
+    let mut walked = 0usize;
+    for topic in &topics {
+        for partition in &topic.partitions {
+            let code = partition.error_code;
+            if first == 0 && code != 0 {
+                first = code;
+            }
+            if first_fatal == 0 && add_partitions_error_is_fatal(code, can_handle_abortable) {
+                first_fatal = code;
+                // The existing parser has consumed the body with no trailing
+                // bytes. It does not check requested partition coverage.
+                // Publish before this scan can yield after seeing a fence.
+                on_fatal(code);
+            }
+            walked = walked.saturating_add(1);
+            if walked == 8 * 1024 {
+                walked = 0;
+                tokio::task::yield_now().await;
+            }
+        }
+    }
+    Ok(if first_fatal == 0 { first } else { first_fatal })
+}
