+/// Fatal AddPartitions errors for the negotiated transaction capabilities.
+pub(crate) fn add_partitions_error_is_fatal(code: i16, can_handle_abortable: bool) -> bool {
+    use crate::error::{
+        INVALID_PRODUCER_EPOCH, INVALID_PRODUCER_ID_MAPPING, INVALID_TXN_STATE, PRODUCER_FENCED,
+        TRANSACTIONAL_ID_AUTHORIZATION_FAILED, UNKNOWN_PRODUCER_ID,
+    };
+    matches!(
+        code,
+        INVALID_PRODUCER_EPOCH
+            | PRODUCER_FENCED
+            | TRANSACTIONAL_ID_AUTHORIZATION_FAILED
+            | INVALID_TXN_STATE
+            | INVALID_PRODUCER_ID_MAPPING
+    ) || (code == UNKNOWN_PRODUCER_ID && !can_handle_abortable)
+}
