+            );
+            assert_eq!(socket.offers.first(), Some(&vec![4, 8 * 1024 - 4]));
+            assert!(socket
+                .offers
+                .iter()
+                .all(|offer| offer.iter().sum::<usize>() <= 8 * 1024));
+        }
+    }
