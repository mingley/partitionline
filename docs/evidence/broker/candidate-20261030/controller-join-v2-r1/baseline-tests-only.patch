+    // Baseline-only phase witness: with all admission permits held, the old
+    // code reports its existing inner deadline before the outer test timeout.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn baseline_over_capacity_hits_admission_deadline_with_permits_held() -> TestResult {
+        let storage = StorageLimits::standard()?;
+        let source = LocalOwner::open_profile_with_command_ms(0, 1, 1, 16, storage, 100, 1000).await?;
+        let handle = Handle { control: source.control.clone() };
+        let permits = source.control.clients.clone()
+            .acquire_many_owned(u32::try_from(source.control.config.limits.client_slots)?)
+            .await?;
+        assert_eq!(source.control.clients.available_permits(), 0);
+        let limit = command_payload_limit(&source.control.config.controller, storage, source.control.config.limits);
+        let mut input = Vec::with_capacity(limit + 1);
+        input.push(b'x');
+        assert!(input.capacity() > limit);
+        let result = tokio::time::timeout(Duration::from_secs(2), handle.propose(input)).await?;
+        assert!(matches!(result, Err(Error::Deadline)), "baseline admission result: {result:?}");
+        assert_eq!(source.control.clients.available_permits(), 0);
+        drop(permits);
+        source.finish().await
+    }
+
+    #[test]
+    fn proposal_capacity_check_keeps_the_original_allocation() -> TestResult {
+        let mut input = Vec::with_capacity(32);
+        input.push(b'x');
+        let pointer = input.as_ptr();
+        let capacity = input.capacity();
+        let accepted = bounded_proposal(input, 1, capacity)?;
+        assert_eq!(accepted.as_ptr(), pointer);
+        assert_eq!(accepted.capacity(), capacity);
+        assert_eq!(accepted.as_slice(), b"x");
+        Ok(())
+    }
