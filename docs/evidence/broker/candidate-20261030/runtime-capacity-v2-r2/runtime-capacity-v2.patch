+fn command_payload_limit(
+    controller: &protocol::Config,
+    storage: StorageLimits,
+    limits: Limits,
+) -> usize {
+    limits
+        .frame_bytes
+        .max(storage.fetch_bytes)
+        .max(controller.protocol_limits.max_request_bytes())
+}
+
+fn bounded_proposal(
+    bytes: Vec<u8>,
+    record_limit: usize,
+    allocation_limit: usize,
+) -> Result<Vec<u8>> {
+    if bytes.is_empty() || bytes.len() > record_limit || bytes.capacity() > allocation_limit {
+        return Err(Error::InvalidConfig);
+    }
+    Ok(bytes)
+}
