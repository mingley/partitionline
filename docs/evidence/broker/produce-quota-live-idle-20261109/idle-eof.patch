+// Probe only an otherwise idle stream. If one application byte arrives, keep
+// it for the next frame and stop reading until the pause ends. EOF behind that
+// byte, or behind existing read-ahead, remains unobservable during the pause.
+async fn watch_idle_pause<S: AsyncRead + Unpin>(socket: &mut S, ahead: &mut ReadAhead) -> Exit {
+    if !ahead.is_empty() {
+        return std::future::pending().await;
+    }
+    let mut byte = [0u8; 1];
+    match socket.read(&mut byte).await {
+        Ok(0) => Exit::PeerClosed,
+        Ok(_) => {
+            ahead.compact();
+            let bytes = frame_mut(&mut ahead.bytes);
+            if bytes.try_reserve(1).is_err() {
+                return Exit::Io;
+            }
+            bytes.push(byte[0]);
+            std::future::pending().await
+        }
+        Err(error) => read_error(error),
+    }
+}
