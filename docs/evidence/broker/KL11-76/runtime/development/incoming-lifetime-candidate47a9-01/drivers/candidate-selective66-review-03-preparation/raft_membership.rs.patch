+const POLLED_IMAGE_CHUNK_BYTES: usize = 128;
+
+// A narrower real donor Store makes the 431-byte canonical image require
+// multiple actual chunks without increasing record or capture-size budgets.
+fn reopen_polled_image_donor(group: &mut DynamicGroup) -> Result {
+    drop(group.nodes[0].take());
+    let local = &group.local[0];
+    let name = format!("{}-{}", local.key().id, hex_bytes(&local.key().directory)?);
+    let mut controller = protocol::Config::new(
+        local.key().id,
+        vec![local.key().id],
+        "membership-test".into(),
+    )?;
+    controller.election_timeouts = Timeouts::new(DYNAMIC_ELECTION_MIN_MS, DYNAMIC_ELECTION_MAX_MS)?;
+    let mut config = replication::Config::new(controller);
+    config.quorum_timeout_ms = DYNAMIC_QUORUM_TIMEOUT_MS;
+    let identity = snapshot::Identity::dynamic(
+        "membership-test".into(),
+        "__cluster_metadata".into(),
+        0,
+        group.genesis.clone(),
+    )?;
+    let defaults = snapshot::Limits::default();
+    let limits = snapshot::Limits::new(
+        defaults.image_bytes(),
+        defaults.records(),
+        defaults.payload_bytes(),
+        defaults.record_bytes(),
+        POLLED_IMAGE_CHUNK_BYTES,
+        defaults.generations(),
+        32,
+    )?;
+    let store = snapshot::Store::open(group.root.join(format!("{name}.images")), identity, limits)?;
+    group.nodes[0] = Some(Node::open_dynamic(
+        group.root.join(format!("{name}.wal")),
+        group.root.join(format!("{name}.election")),
+        config,
+        Bootstrap::new(local.clone(), group.genesis.clone(), "CONTROLLER".into())?,
+        Some(store),
+        0,
+    )?);
+    Ok(())
+}
