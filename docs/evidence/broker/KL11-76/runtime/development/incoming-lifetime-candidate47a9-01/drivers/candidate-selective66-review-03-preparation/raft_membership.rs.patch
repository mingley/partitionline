+#[test]
+fn incoming_dynamic_image_publication_io_error_poison_fences_late_chunks_and_finish() -> Result {
+    let (mut group, offer, _) = polled_incoming_image_fixture()?;
+    group.node(3)?.poll(17)?;
+    loop {
+        let chunk = group.node(0)?.dynamic_snapshot_chunk(offer, 17)?;
+        group
+            .node(3)?
+            .receive_dynamic_snapshot_chunk(offer, chunk.offset, &chunk.bytes, 17)?;
+        if chunk.done {
+            break;
+        }
+    }
+    // A genuine local namespace replacement makes the actual publication rename
+    // fail after all bytes were received. No successful Install is synthesized.
+    let key = group.key(3);
+    let images = group
+        .root
+        .join(format!("{}-{}.images", key.id, hex_bytes(&key.directory)?));
+    fs::rename(&images, images.with_extension("displaced-images"))?;
+    fs::write(&images, b"actual namespace replacement blocks publication")?;
+    assert!(group.node(3)?.finish_dynamic_snapshot(offer, 17).is_err());
+    assert!(group.node(3)?.state().poisoned);
+    assert!(!group.node(3)?.state().ready);
+    assert!(group
+        .node(3)?
+        .receive_dynamic_snapshot_chunk(offer, 0, b"late", 18)
+        .is_err());
+    assert!(group.node(3)?.finish_dynamic_snapshot(offer, 18).is_err());
+    assert!(group.node(3)?.begin_dynamic_snapshot(offer, 18).is_err());
+    Ok(())
+}
