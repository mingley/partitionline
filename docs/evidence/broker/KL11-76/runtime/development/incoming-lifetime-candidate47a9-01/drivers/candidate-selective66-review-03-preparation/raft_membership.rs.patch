+#[test]
+fn incoming_dynamic_image_old_offer_cannot_survive_a_real_higher_term_known_leader() -> Result {
+    let (mut group, offer, _) = polled_incoming_image_fixture()?;
+    let chunk = group.node(0)?.dynamic_snapshot_chunk(offer, 17)?;
+    let next_leader = group.key(1);
+    let peer = group.key(3);
+    let next = replication::DynamicRequest {
+        context: replication::Context {
+            leader: next_leader,
+            peer,
+            configuration_epoch: offer.context.configuration_epoch,
+        },
+        request: replication::Request {
+            leader: next_leader.id,
+            peer: peer.id,
+            sequence: 900,
+            term: offer.request.term + 1,
+            previous: LogPosition::default(),
+            leader_commit: 0,
+            entries: Vec::new(),
+        },
+    };
+    assert!(group.node(3)?.receive_dynamic(&next, 18)?.response.success);
+    group.node(3)?.poll(18)?;
+    assert!(group
+        .node(3)?
+        .receive_dynamic_snapshot_chunk(offer, 0, &chunk.bytes, 18)
+        .is_err());
+    assert!(group.node(3)?.finish_dynamic_snapshot(offer, 18).is_err());
+    assert!(group.node(3)?.selected_snapshot()?.is_none());
+    assert_eq!(
+        group.node(3)?.state().election.persistent.term,
+        next.request.term
+    );
+    let (mut group, offer, _) = voting_incoming_image_fixture()?;
+    let chunk = group.node(0)?.dynamic_snapshot_chunk(offer, 17)?;
+    let requests = group.node(2)?.campaign_dynamic(27)?;
+    assert!(!requests.is_empty());
+    assert_eq!(group.node(2)?.state().election.role, Role::Candidate);
+    assert_eq!(
+        group.node(2)?.state().election.persistent.term,
+        offer.request.term + 1
+    );
+    group.node(2)?.poll(27)?;
+    assert!(matches!(
+        group
+            .node(2)?
+            .receive_dynamic_snapshot_chunk(offer, 0, &chunk.bytes, 27),
+        Err(replication::Error::InvalidPeer)
+    ));
+    assert!(matches!(
+        group.node(2)?.finish_dynamic_snapshot(offer, 27),
+        Err(replication::Error::InvalidPeer)
+    ));
+    assert!(group.node(2)?.selected_snapshot()?.is_none());
+    assert_no_partial_image(&group, 2)?;
+    Ok(())
+}
