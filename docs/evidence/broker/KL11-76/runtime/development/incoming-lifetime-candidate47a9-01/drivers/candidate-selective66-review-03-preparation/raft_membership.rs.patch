+#[test]
+fn incoming_dynamic_image_rejects_changed_offer_and_abort_or_expiry_cannot_revive_it() -> Result {
+    let (mut group, offer, _) = polled_incoming_image_fixture()?;
+    group.node(3)?.poll(17)?;
+    let chunk = group.node(0)?.dynamic_snapshot_chunk(offer, 17)?;
+    let before = group.node(3)?.state();
+    let mut forged = Vec::new();
+    let mut q = offer;
+    q.context.peer.directory = [91; 16];
+    forged.push(q);
+    q = offer;
+    q.context.leader.directory = [92; 16];
+    forged.push(q);
+    q = offer;
+    q.context.configuration_epoch += 1;
+    forged.push(q);
+    q = offer;
+    q.request.term += 1;
+    forged.push(q);
+    q = offer;
+    q.request.leader += 1;
+    forged.push(q);
+    q = offer;
+    q.request.sequence += 1;
+    forged.push(q);
+    q = offer;
+    q.request.peer += 1;
+    forged.push(q);
+    q = offer;
+    q.request.leader_commit += 1;
+    forged.push(q);
+    q = offer;
+    q.request.descriptor.generation[0] ^= 1;
+    forged.push(q);
+    q = offer;
+    q.request.descriptor.base.term += 1;
+    forged.push(q);
+    q = offer;
+    q.request.descriptor.base.index += 1;
+    forged.push(q);
+    q = offer;
+    q.request.descriptor.records += 1;
+    forged.push(q);
+    q = offer;
+    q.request.descriptor.payload_bytes += 1;
+    forged.push(q);
+    q = offer;
+    q.request.descriptor.bytes += 1;
+    forged.push(q);
+    q = offer;
+    q.request.descriptor.checksum ^= 1;
+    forged.push(q);
+    for q in forged {
+        assert!(matches!(
+            group
+                .node(3)?
+                .receive_dynamic_snapshot_chunk(q, 0, &chunk.bytes, 17),
+            Err(replication::Error::InvalidPeer)
+        ));
+        assert!(matches!(
+            group.node(3)?.finish_dynamic_snapshot(q, 17),
+            Err(replication::Error::InvalidPeer)
+        ));
+        assert!(group.node(3)?.state().ready);
+        assert!(!group.node(3)?.state().poisoned);
+    }
+    let after = group.node(3)?.state();
+    assert_eq!(before.election.persistent, after.election.persistent);
+    assert_eq!(before.wal_durable_ops, after.wal_durable_ops);
+    assert_eq!(
+        before.election_durable_states,
+        after.election_durable_states
+    );
+    // Forged traffic cannot cancel or damage the unchanged real transfer.
+    assert!(chunk.done);
+    group
+        .node(3)?
+        .receive_dynamic_snapshot_chunk(offer, 0, &chunk.bytes, 17)?;
+    let response = group.node(3)?.finish_dynamic_snapshot(offer, 17)?;
+    group.node(0)?.acknowledge_dynamic_snapshot(response, 17)?;
+    let committed = group.node(3)?.fetch_committed(1, 8, 2 * 1024 * 1024)?;
+    group.reopen(3, 18)?;
+    assert_eq!(
+        group.node(3)?.selected_snapshot()?,
+        Some(offer.request.descriptor)
+    );
+    assert_eq!(
+        group.node(3)?.fetch_committed(1, 8, 2 * 1024 * 1024)?,
+        committed
+    );
+
+    let (mut group, offer, _) = polled_incoming_image_fixture()?;
+    let chunk = group.node(0)?.dynamic_snapshot_chunk(offer, 17)?;
+    group.node(3)?.abort_snapshot()?;
+    assert!(matches!(
+        group
+            .node(3)?
+            .receive_dynamic_snapshot_chunk(offer, 0, &chunk.bytes, 18),
+        Err(replication::Error::InvalidPeer)
+    ));
+    assert!(matches!(
+        group.node(3)?.finish_dynamic_snapshot(offer, 18),
+        Err(replication::Error::InvalidPeer)
+    ));
+    assert!(group.node(3)?.selected_snapshot()?.is_none());
+    assert_no_partial_image(&group, 3)?;
+
+    // Equality is accepted by the receiving deadline. The donor's bytes were
+    // produced earlier under its real offer; this tests receiver expiry only.
+    let (mut group, offer, _) = polled_incoming_image_fixture()?;
+    let chunk = group.node(0)?.dynamic_snapshot_chunk(offer, 17)?;
+    assert!(chunk.done);
+    let deadline = 16 + DYNAMIC_QUORUM_TIMEOUT_MS;
+    group.node(3)?.poll(deadline)?;
+    group
+        .node(3)?
+        .receive_dynamic_snapshot_chunk(offer, 0, &chunk.bytes, deadline)?;
+    group.node(3)?.finish_dynamic_snapshot(offer, deadline)?;
+    assert_eq!(
+        group.node(3)?.selected_snapshot()?,
+        Some(offer.request.descriptor)
+    );
+    assert_no_partial_image(&group, 3)?;
+
+    let (mut group, offer, _) = polled_incoming_image_fixture()?;
+    let chunk = group.node(0)?.dynamic_snapshot_chunk(offer, 17)?;
+    group.node(3)?.poll(16 + DYNAMIC_QUORUM_TIMEOUT_MS + 1)?;
+    assert!(group
+        .node(3)?
+        .receive_dynamic_snapshot_chunk(offer, 0, &chunk.bytes, 16 + DYNAMIC_QUORUM_TIMEOUT_MS + 1)
+        .is_err());
+    assert!(group
+        .node(3)?
+        .finish_dynamic_snapshot(offer, 16 + DYNAMIC_QUORUM_TIMEOUT_MS + 1)
+        .is_err());
+    assert!(group.node(3)?.selected_snapshot()?.is_none());
+    assert_no_partial_image(&group, 3)?;
+    Ok(())
+}
