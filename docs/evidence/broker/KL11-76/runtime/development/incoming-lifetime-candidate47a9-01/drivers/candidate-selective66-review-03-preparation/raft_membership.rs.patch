+#[test]
+fn incoming_dynamic_image_survives_follower_polls_and_preserves_local_vote_on_reopen() -> Result {
+    let (mut group, offer, vote) = polled_incoming_multichunk_fixture()?;
+    assert_eq!(group.node(3)?.state().election.role, Role::Follower);
+    preserve_polled_image_fixture(&mut group, "before-poll", offer, "valid Begin completed")?;
+    group.node(3)?.poll(17)?;
+    preserve_polled_image_fixture(
+        &mut group,
+        "after-poll",
+        offer,
+        "unchanged Follower poll completed",
+    )?;
+    let mut chunks = 0;
+    loop {
+        let chunk = group.node(0)?.dynamic_snapshot_chunk(offer, 17)?;
+        chunks += 1;
+        assert!(chunk.bytes.len() <= POLLED_IMAGE_CHUNK_BYTES);
+        let result =
+            group
+                .node(3)?
+                .receive_dynamic_snapshot_chunk(offer, chunk.offset, &chunk.bytes, 17);
+        if chunk.offset == 0 {
+            preserve_polled_image_fixture(
+                &mut group,
+                "after-first-chunk",
+                offer,
+                &format!("{result:?}"),
+            )?;
+        }
+        result?;
+        group.node(3)?.poll(17)?;
+        if chunk.done {
+            break;
+        }
+    }
+    assert!(
+        chunks >= 3,
+        "successful path must consume multiple actual bounded chunks"
+    );
+    let response = group.node(3)?.finish_dynamic_snapshot(offer, 17)?;
+    group.node(0)?.acknowledge_dynamic_snapshot(response, 17)?;
+    preserve_polled_image_fixture(
+        &mut group,
+        "after-finish",
+        offer,
+        "actual Finish/ACK completed",
+    )?;
+    assert_eq!(
+        group.node(3)?.selected_snapshot()?,
+        Some(offer.request.descriptor)
+    );
+    assert_eq!(group.node(3)?.voted_directory()?, vote);
+    let committed = group.node(3)?.fetch_committed(1, 8, 2 * 1024 * 1024)?;
+    assert_eq!(committed.len() as u64, offer.request.descriptor.base.index);
+    group.reopen(3, 18)?;
+    preserve_polled_image_fixture(&mut group, "after-reopen", offer, "selected image reopened")?;
+    assert_eq!(
+        group.node(3)?.selected_snapshot()?,
+        Some(offer.request.descriptor)
+    );
+    assert_eq!(group.node(3)?.voted_directory()?, vote);
+    assert_eq!(
+        group.node(3)?.fetch_committed(1, 8, 2 * 1024 * 1024)?,
+        committed
+    );
+    // A genuine existing voter granted the original same-term leader request.
+    // Its non-null vote must survive a separate successful install and restart.
+    let (mut voting, offer, vote) = voting_incoming_image_fixture()?;
+    assert_eq!(vote, Some(voting.key(0)));
+    voting.node(2)?.poll(17)?;
+    let mut voting_chunks = 0;
+    loop {
+        let chunk = voting.node(0)?.dynamic_snapshot_chunk(offer, 17)?;
+        voting_chunks += 1;
+        assert!(chunk.bytes.len() <= POLLED_IMAGE_CHUNK_BYTES);
+        voting
+            .node(2)?
+            .receive_dynamic_snapshot_chunk(offer, chunk.offset, &chunk.bytes, 17)?;
+        voting.node(2)?.poll(17)?;
+        if chunk.done {
+            break;
+        }
+    }
+    assert!(voting_chunks >= 3);
+    let response = voting.node(2)?.finish_dynamic_snapshot(offer, 17)?;
+    voting.node(0)?.acknowledge_dynamic_snapshot(response, 17)?;
+    let committed = voting.node(2)?.fetch_committed(1, 8, 2 * 1024 * 1024)?;
+    voting.reopen(2, 18)?;
+    assert_eq!(voting.node(2)?.voted_directory()?, vote);
+    assert_eq!(
+        voting.node(2)?.state().election.persistent.term,
+        offer.request.term
+    );
+    assert_eq!(
+        voting.node(2)?.selected_snapshot()?,
+        Some(offer.request.descriptor)
+    );
+    assert_eq!(
+        voting.node(2)?.fetch_committed(1, 8, 2 * 1024 * 1024)?,
+        committed
+    );
+    preserve_polled_image_fixture_for(
+        &mut voting,
+        2,
+        "voted-after-reopen",
+        offer,
+        "actual non-null same-term vote preserved through install/reopen",
+    )?;
+    Ok(())
+}
+
+fn preserve_polled_image_fixture(
+    group: &mut DynamicGroup,
+    phase: &str,
+    offer: replication::DynamicSnapshotRequest,
+    outcome: &str,
+) -> Result {
+    preserve_polled_image_fixture_for(group, 3, phase, offer, outcome)
+}
+
+fn preserve_polled_image_fixture_for(
+    group: &mut DynamicGroup,
+    receiver: usize,
+    phase: &str,
+    offer: replication::DynamicSnapshotRequest,
+    outcome: &str,
+) -> Result {
+    let Some(root) = std::env::var_os("PL_IMAGE_REGRESSION_CAPTURE_DIR") else {
+        return Ok(());
+    };
+    fn copy(
+        source: &std::path::Path,
+        target: &std::path::Path,
+        depth: usize,
+        files: &mut usize,
+        bytes: &mut u64,
+    ) -> Result {
+        if depth > 3 {
+            return Err("capture directory depth".into());
+        }
+        fs::create_dir_all(target)?;
+        for item in fs::read_dir(source)? {
+            let item = item?;
+            let metadata = fs::symlink_metadata(item.path())?;
+            if metadata.is_dir() {
+                copy(
+                    &item.path(),
+                    &target.join(item.file_name()),
+                    depth + 1,
+                    files,
+                    bytes,
+                )?;
+            } else if metadata.is_file() {
+                *files += 1;
+                *bytes = bytes
+                    .checked_add(metadata.len())
+                    .ok_or("capture byte overflow")?;
+                if *files > 128 || metadata.len() > 2 * 1024 * 1024 || *bytes > 2 * 1024 * 1024 {
+                    return Err("bounded regression capture".into());
+                }
+                let dest = target.join(item.file_name());
+                fn bounded(path: &std::path::Path) -> Result<Vec<u8>> {
+                    use std::io::Read;
+                    let mut bytes = Vec::new();
+                    std::fs::File::open(path)?
+                        .take(2 * 1024 * 1024 + 1)
+                        .read_to_end(&mut bytes)?;
+                    if bytes.len() > 2 * 1024 * 1024 {
+                        return Err("copy comparison bound".into());
+                    }
+                    Ok(bytes)
+                }
+                let original = bounded(&item.path())?;
+                assert_eq!(fs::copy(item.path(), &dest)?, metadata.len());
+                fs::set_permissions(&dest, metadata.permissions())?;
+                assert_eq!(bounded(&dest)?, original);
+                assert_eq!(bounded(&item.path())?, original);
+                #[cfg(unix)]
+                {
+                    use std::os::unix::fs::MetadataExt;
+                    assert_eq!(
+                        fs::metadata(&dest)?.mode() & 0o7777,
+                        metadata.mode() & 0o7777
+                    );
+                    assert_eq!(
+                        fs::metadata(item.path())?.mode() & 0o7777,
+                        metadata.mode() & 0o7777
+                    );
+                }
+                std::fs::File::open(&dest)?.sync_all()?;
+            } else {
+                return Err("capture rejects symlink/special file".into());
+            }
+        }
+        std::fs::File::open(target)?.sync_all()?;
+        Ok(())
+    }
+    let root = PathBuf::from(root).join(phase);
+    let mut files = 0;
+    let mut bytes = 0;
+    copy(&group.root, &root, 0, &mut files, &mut bytes)?;
+    let facts=format!("actual declared experiment source; incoming-image phase receipt (source bindings in runner validation)\nphase={phase}\noffer={offer:?}\noutcome={outcome}\nreceiver_state={:?}\nreceiver_vote={:?}\n",group.node(receiver)?.state(),group.node(receiver)?.voted_directory()?);
+    if facts.len() > 8192 {
+        return Err("facts bound".into());
+    }
+    fs::write(root.join("actual-facts.txt"), facts)?;
+    std::fs::File::open(root.join("actual-facts.txt"))?.sync_all()?;
+    std::fs::File::open(root)?.sync_all()?;
+    Ok(())
+}
