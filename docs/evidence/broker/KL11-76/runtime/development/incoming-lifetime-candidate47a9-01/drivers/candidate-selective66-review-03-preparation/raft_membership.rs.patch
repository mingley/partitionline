+fn assert_no_partial_image(group: &DynamicGroup, receiver: usize) -> Result {
+    let key = group.key(receiver);
+    let images = group
+        .root
+        .join(format!("{}-{}.images", key.id, hex_bytes(&key.directory)?));
+    for entry in fs::read_dir(images)? {
+        assert!(!entry?.file_name().to_string_lossy().ends_with(".partial"));
+    }
+    Ok(())
+}
