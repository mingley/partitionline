+#[cfg(test)]
+mod controller_queue_capacity_tests {
+    use super::{Command, Config, ControllerHandler, ControllerJoin, Error};
+    use crate::protocol;
+    use std::{
+        future::{poll_fn, Future},
+        sync::{atomic::AtomicBool, Arc},
+        task::Poll,
+        time::Duration,
+    };
+    use tokio::sync::{mpsc, Mutex};
+
+    type TestResult = Result<(), Box<dyn std::error::Error + Send + Sync>>;
+    const WAIT: Duration = Duration::from_secs(5);
+
+    // The receiver is controlled by the test; this fixture does not run a WAL.
+    fn fixture(limit: usize) -> Result<(ControllerHandler, mpsc::Receiver<Command>), Error> {
+        let mut config = Config::new(1, vec![1], "queue-test".to_owned())?;
+        config.protocol_limits = protocol::Limits::new(limit, 0)?;
+        config.max_queued_requests = 1;
+        let (sender, receiver) = mpsc::channel(1);
+        let task = tokio::spawn(async {});
+        Ok((
+            ControllerHandler {
+                sender,
+                stopping: Arc::new(AtomicBool::new(false)),
+                join: Mutex::new(ControllerJoin::Running(task)),
+                config,
+            },
+            receiver,
+        ))
+    }
+
+    #[tokio::test]
+    async fn queued_capacity_preserves_bytes_and_reuses_fitting_buffers() -> TestResult {
+        for oversized_request in [false, true] {
+            for oversized_spare in [false, true] {
+                let (handler, mut receiver) = fixture(64)?;
+                let request = if oversized_request {
+                    let mut request = Vec::with_capacity(128);
+                    request.extend_from_slice(b"request");
+                    request
+                } else {
+                    b"request".to_vec().into_boxed_slice().into_vec()
+                };
+                let request_ptr = request.as_ptr();
+                let spare = if oversized_spare {
+                    Vec::with_capacity(128)
+                } else {
+                    let mut spare = vec![0_u8; 16].into_boxed_slice().into_vec();
+                    spare.clear();
+                    spare
+                };
+                let spare_ptr = spare.as_ptr();
+                let spare_capacity = spare.capacity();
+                let mut pending = Box::pin(handler.submit(request, spare));
+                poll_fn(|cx| {
+                    assert!(pending.as_mut().poll(cx).is_pending());
+                    Poll::Ready(())
+                })
+                .await;
+                let job = match receiver.try_recv()? {
+                    Command::Request(job) => job,
+                    Command::Stop => return Err("unexpected stop".into()),
+                };
+                assert_eq!(job.request.as_slice(), b"request");
+                assert!(job.request.capacity() + job.spare.capacity() <= 64);
+                if !oversized_request {
+                    assert_eq!(job.request.as_ptr(), request_ptr);
+                }
+                if spare_capacity > 64 - job.request.capacity() {
+                    assert_eq!(job.spare.capacity(), 0);
+                } else {
+                    assert_eq!(job.spare.as_ptr(), spare_ptr);
+                }
+                let sent = job.reply.send(Ok((vec![9], job.request)));
+                assert!(sent.is_ok());
+                let (response, returned) = tokio::time::timeout(WAIT, pending).await??;
+                assert_eq!(response, [9]);
+                assert_eq!(returned.as_slice(), b"request");
+                if !oversized_request {
+                    assert_eq!(returned.as_ptr(), request_ptr);
+                }
+                drop(receiver);
+                tokio::time::timeout(WAIT, handler.shutdown()).await??;
+            }
+        }
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn full_queue_length_and_stop_results_are_preserved() -> TestResult {
+        let (handler, mut receiver) = fixture(64)?;
+        let mut first = Box::pin(handler.submit(vec![1], Vec::new()));
+        poll_fn(|cx| {
+            assert!(first.as_mut().poll(cx).is_pending());
+            Poll::Ready(())
+        })
+        .await;
+        assert!(matches!(
+            handler.submit(vec![2], Vec::new()).await,
+            Err(Error::Busy)
+        ));
+        let mut over_capacity = Vec::with_capacity(65);
+        over_capacity.push(3);
+        assert!(matches!(
+            handler.submit(over_capacity, Vec::new()).await,
+            Err(Error::Busy)
+        ));
+        assert!(matches!(
+            handler.submit(vec![0; 65], Vec::new()).await,
+            Err(Error::Protocol(protocol::Error::RequestTooLarge))
+        ));
+        let job = match receiver.try_recv()? {
+            Command::Request(job) => job,
+            Command::Stop => return Err("unexpected stop".into()),
+        };
+        assert!(job.reply.send(Ok((Vec::new(), job.request))).is_ok());
+        let _reply = tokio::time::timeout(WAIT, first).await??;
+        drop(receiver);
+        tokio::time::timeout(WAIT, handler.shutdown()).await??;
+        assert!(matches!(
+            handler.submit(vec![4], Vec::new()).await,
+            Err(Error::Stopped)
+        ));
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn canceling_copy_leaves_no_reserved_slot_or_queued_request() -> TestResult {
+        const LIMIT: usize = 128 * 1024;
+        let (handler, mut receiver) = fixture(LIMIT)?;
+        let mut request = Vec::with_capacity(LIMIT + 1);
+        request.resize(LIMIT, 7);
+        let mut pending = Box::pin(handler.submit(request, Vec::new()));
+        poll_fn(|cx| {
+            assert!(pending.as_mut().poll(cx).is_pending());
+            Poll::Ready(())
+        })
+        .await;
+        assert!(matches!(
+            receiver.try_recv(),
+            Err(mpsc::error::TryRecvError::Empty)
+        ));
+        drop(pending);
+        assert!(matches!(
+            receiver.try_recv(),
+            Err(mpsc::error::TryRecvError::Empty)
+        ));
+        drop(receiver);
+        tokio::time::timeout(WAIT, handler.shutdown()).await??;
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn stop_during_copy_prevents_late_admission() -> TestResult {
+        const LIMIT: usize = 128 * 1024;
+        let (handler, mut receiver) = fixture(LIMIT)?;
+        let mut request = Vec::with_capacity(LIMIT + 1);
+        request.resize(LIMIT, 7);
+        let mut pending = Box::pin(handler.submit(request, Vec::new()));
+        poll_fn(|cx| {
+            assert!(pending.as_mut().poll(cx).is_pending());
+            Poll::Ready(())
+        })
+        .await;
+        handler
+            .stopping
+            .store(true, std::sync::atomic::Ordering::Release);
+        assert!(matches!(
+            tokio::time::timeout(WAIT, pending).await?,
+            Err(Error::Stopped)
+        ));
+        assert!(matches!(
+            receiver.try_recv(),
+            Err(mpsc::error::TryRecvError::Empty)
+        ));
+        drop(receiver);
+        tokio::time::timeout(WAIT, handler.shutdown()).await??;
+        Ok(())
+    }
+}
