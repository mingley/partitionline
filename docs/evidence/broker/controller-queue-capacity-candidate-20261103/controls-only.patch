+// Add retained request capacity as read-ahead may do, then delegate through
+// the actual controller and socket transport. Samples precede submission.
+struct QueueCapacityTrace {
+    inner: Arc<ControllerHandler>,
+    capacities: tokio::sync::mpsc::UnboundedSender<(usize, usize)>,
+}
+
+impl Handler for QueueCapacityTrace {
+    type Error = Error;
+
+    async fn handle(&self, request: Vec<u8>) -> std::result::Result<Option<Vec<u8>>, Error> {
+        self.inner.handle(request).await
+    }
+
+    async fn exchange_request(
+        &self,
+        peer: &transport::Peer,
+        mut request: Vec<u8>,
+        spare: Vec<u8>,
+    ) -> std::result::Result<transport::ExchangeOutcome, Error> {
+        request.reserve(33);
+        let _sent = self.capacities.send((request.capacity(), spare.capacity()));
+        self.inner.exchange_request(peer, request, spare).await
+    }
+}
+
+#[tokio::test]
+async fn controller_reuses_connection_with_over_reserved_requests_and_response_spare() -> Result {
+    const LIMIT: usize = 32;
+    const WAIT: Duration = Duration::from_secs(5);
+    let temp = Temp::new()?;
+    let mut cfg = config(1)?;
+    cfg.protocol_limits = Limits::new(LIMIT, 0)?;
+    cfg.max_queued_requests = 1;
+    let handler = Arc::new(ControllerHandler::open(temp.path("capacity-actor"), cfg).await?);
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let traced = Arc::new(QueueCapacityTrace {
+        inner: handler.clone(),
+        capacities: tx,
+    });
+    let limits = transport::Config::new(2, 1, LIMIT, 1024, WAIT, WAIT, WAIT)?;
+    let mut server = match Transport::bind("127.0.0.1:0".parse()?, limits, traced).await {
+        Ok(server) => server,
+        Err(error) => {
+            let _stopped = tokio::time::timeout(WAIT, handler.shutdown()).await;
+            return Err(error.into());
+        }
+    };
+    let observed: Result = match tokio::time::timeout(WAIT, async {
+        let mut stream = TcpStream::connect(server.local_addr()).await?;
+        for correlation in [71, 72] {
+            let request = header(18, 0, correlation);
+            stream.write_i32(i32::try_from(request.len())?).await?;
+            stream.write_all(&request).await?;
+            let size = usize::try_from(stream.read_i32().await?)?;
+            if size > 1024 {
+                return Err("unexpected response size".into());
+            }
+            let mut response = vec![0; size];
+            let _read = stream.read_exact(&mut response).await?;
+            if response.get(..4) != Some(correlation.to_be_bytes().as_slice()) {
+                return Err("wrong response correlation".into());
+            }
+            let (request_capacity, spare_capacity) =
+                rx.recv().await.ok_or("missing capacity sample")?;
+            if request_capacity <= LIMIT || (correlation == 72 && spare_capacity <= LIMIT) {
+                return Err("exchange did not exercise excess capacity".into());
+            }
+        }
+        Ok(())
+    })
+    .await
+    {
+        Ok(result) => result,
+        Err(error) => Err(Box::new(error)),
+    };
+    let server_result = tokio::time::timeout(WAIT, server.shutdown()).await;
+    let handler_result = tokio::time::timeout(WAIT, handler.shutdown()).await;
+    observed?;
+    server_result??;
+    handler_result??;
+    Ok(())
+}
