+fn checkpoint_length(coordinator: &Coordinator, event: &[u8]) -> Result<usize, Error> {
+    let _ = u32::try_from(coordinator.transactions.len()).map_err(|_| Error::InvalidLimits)?;
+    let _ = u32::try_from(event.len()).map_err(|_| Error::InvalidLimits)?;
+    let mut len = CHECKPOINT_MAGIC.len() + 8 + 8 + 4 + 4;
+    len = len.checked_add(event.len()).ok_or(Error::InvalidLimits)?;
+    for (id, txn) in &coordinator.transactions {
+        let _ = u16::try_from(id.len()).map_err(|_| Error::InvalidLimits)?;
+        let _ = u16::try_from(txn_partition_count(&txn.partitions))
+            .map_err(|_| Error::InvalidLimits)?;
+        len = len
+            .checked_add(2 + id.len() + 8 + 2 + 1 + 2)
+            .ok_or(Error::InvalidLimits)?;
+        for (topic, partitions) in &txn.partitions {
+            let _ = u16::try_from(topic.len()).map_err(|_| Error::InvalidLimits)?;
+            let one = 2 + topic.len() + 4;
+            len = len
+                .checked_add(
+                    one.checked_mul(partitions.len())
+                        .ok_or(Error::InvalidLimits)?,
+                )
+                .ok_or(Error::InvalidLimits)?;
+        }
+    }
+    Ok(len)
+}
+
+fn encode_checkpoint(
+    coordinator: &Coordinator,
+    event: &[u8],
+    out: &mut Vec<u8>,
+) -> Result<(), Error> {
+    let len = checkpoint_length(coordinator, event)?;
+    if len > coordinator.limits.journal.max_entry_bytes()
+        || len
+            .checked_add(std::mem::size_of::<journal::Entry>())
+            .is_none_or(|size| size > coordinator.limits.journal.max_fetch_bytes())
+    {
+        return Err(Error::InvalidLimits);
+    }
+    out.clear();
+    out.try_reserve_exact(len)
+        .map_err(|_| Error::InvalidLimits)?;
+    out.extend_from_slice(CHECKPOINT_MAGIC);
+    out.extend_from_slice(&coordinator.epoch.to_be_bytes());
+    out.extend_from_slice(&coordinator.next_producer.to_be_bytes());
+    out.extend_from_slice(
+        &u32::try_from(coordinator.transactions.len())
+            .map_err(|_| Error::InvalidLimits)?
+            .to_be_bytes(),
+    );
+    for (id, txn) in &coordinator.transactions {
+        put_str(out, id)?;
+        out.extend_from_slice(&txn.producer_id.to_be_bytes());
+        out.extend_from_slice(&txn.producer_epoch.to_be_bytes());
+        out.push(state_byte(txn.state));
+        out.extend_from_slice(
+            &u16::try_from(txn_partition_count(&txn.partitions))
+                .map_err(|_| Error::InvalidLimits)?
+                .to_be_bytes(),
+        );
+        for (topic, partitions) in &txn.partitions {
+            for partition in partitions {
+                put_str(out, topic)?;
+                out.extend_from_slice(&partition.to_be_bytes());
+            }
+        }
+    }
+    out.extend_from_slice(
+        &u32::try_from(event.len())
+            .map_err(|_| Error::InvalidLimits)?
+            .to_be_bytes(),
+    );
+    out.extend_from_slice(event);
+    debug_assert_eq!(out.len(), len);
+    Ok(())
+}
+
+fn decode_checkpoint(
+    bytes: &[u8],
+    limits: Limits,
+) -> Result<(i64, i64, BTreeMapTxn, &[u8]), Error> {
+    if bytes.get(..8) != Some(CHECKPOINT_MAGIC.as_slice()) {
+        return Err(Error::InvalidRequest);
+    }
+    let mut bytes = &bytes[8..];
+    let epoch = take_i64(&mut bytes)?;
+    let next_producer = take_i64(&mut bytes)?;
+    let count = usize::try_from(u32::from_be_bytes(
+        take(&mut bytes, 4)?
+            .try_into()
+            .map_err(|_| Error::InvalidRequest)?,
+    ))
+    .map_err(|_| Error::InvalidLimits)?;
+    if epoch < 0
+        || count > limits.max_transactions
+        || count > bytes.len() / 16
+        || i64::try_from(count)
+            .ok()
+            .and_then(|count| count.checked_add(1))
+            != Some(next_producer)
+    {
+        return Err(Error::InvalidRequest);
+    }
+    let mut transactions = BTreeMapTxn::new();
+    let mut producer_ids = BTreeSet::new();
+    for _ in 0..count {
+        let id = take_str(&mut bytes)?;
+        validate_id(&id)?;
+        let producer_id = take_i64(&mut bytes)?;
+        let producer_epoch = take_i16(&mut bytes)?;
+        let state = match take(&mut bytes, 1)?[0] {
+            0 => State::Empty,
+            1 => State::Ongoing,
+            2 => State::PrepareCommit,
+            3 => State::PrepareAbort,
+            4 => State::CompleteCommit,
+            5 => State::CompleteAbort,
+            _ => return Err(Error::InvalidRequest),
+        };
+        let partition_count = usize::from(u16::from_be_bytes(
+            take(&mut bytes, 2)?
+                .try_into()
+                .map_err(|_| Error::InvalidRequest)?,
+        ));
+        if producer_id <= 0
+            || producer_id >= next_producer
+            || producer_epoch < 0
+            || !producer_ids.insert(producer_id)
+            || partition_count > 64
+            || (state == State::Empty && partition_count != 0)
+        {
+            return Err(Error::InvalidRequest);
+        }
+        let mut partitions = TxnPartitions::new();
+        for _ in 0..partition_count {
+            let topic = take_str(&mut bytes)?;
+            let partition = take_i32(&mut bytes)?;
+            if catalog::validate_topic_name(&topic).is_err()
+                || partition < 0
+                || txn_has_partition(&partitions, &topic, partition)
+            {
+                return Err(Error::InvalidRequest);
+            }
+            txn_add_partition(&mut partitions, &topic, partition);
+        }
+        if transactions
+            .insert(
+                id,
+                Transaction {
+                    producer_id,
+                    producer_epoch,
+                    state,
+                    partitions,
+                },
+            )
+            .is_some()
+        {
+            return Err(Error::InvalidRequest);
+        }
+    }
+    let event_len = usize::try_from(u32::from_be_bytes(
+        take(&mut bytes, 4)?
+            .try_into()
+            .map_err(|_| Error::InvalidRequest)?,
+    ))
+    .map_err(|_| Error::InvalidLimits)?;
+    let event = take(&mut bytes, event_len)?;
+    if !bytes.is_empty() || event.is_empty() {
+        return Err(Error::InvalidRequest);
+    }
+    Ok((epoch, next_producer, transactions, event))
+}
