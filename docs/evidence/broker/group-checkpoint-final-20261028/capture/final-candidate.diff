+            .unwrap_or_else(|error| panic!("{error:?}"));
+        let joined = groups
+            .heartbeat(beat("g", "", 0, 1, &["orders"]))
+            .unwrap_or_else(|error| panic!("{error:?}"));
+        let mut epoch = joined.member_epoch;
+        for now in 1..=40 {
+            let mut ping = beat("g", &joined.member_id, epoch, 1, &["orders"]);
+            ping.now_ms = now;
+            epoch = groups
