+            && self.inner.index.len() < self.inner.limits.max_index_entries
+            && self
+                .inner
+                .file_bytes
+                .checked_add(ENTRY_HEADER as u64)
+                .and_then(|size| size.checked_add(payload_len as u64))
+                .is_some_and(|size| size <= self.inner.limits.max_file_bytes)
