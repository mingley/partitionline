+                .member_epoch;
+            assert!(groups.journal.entry_count() <= entries.min(8));
+            assert!(groups.journal.file_bytes() <= file_bytes);
+            if now % 10 == 0 {
+                drop(groups);
+                groups = Groups::open(&path, limits).unwrap_or_else(|error| panic!("{error:?}"));
+                let view = groups
