+    #[test]
+    fn gzip_reservation_hint_cannot_bypass_validation() {
+        let payload = vec![0x42; 9000];
+        let compressed = Compression::Gzip.codec_compress(&payload).unwrap();
+        for claimed in [0u32, 1, 8192, u32::MAX] {
+            let mut corrupt = compressed.clone();
+            let trailer = corrupt.len() - 4;
+            corrupt[trailer..].copy_from_slice(&claimed.to_le_bytes());
+            assert!(gzip_decompress(&corrupt, payload.len()).is_err());
+            assert!(gzip_decompress(&corrupt, payload.len() - 1).is_err());
+        }
+        // Reading exactly the hinted length must still validate the checksum.
+        let mut bad_crc = compressed.clone();
+        let crc = bad_crc.len() - 8;
+        bad_crc[crc] ^= 1;
+        assert!(gzip_decompress(&bad_crc, payload.len()).is_err());
+    }
+
+    #[test]
+    fn snappy_multiple_chunks_share_one_bounded_output() {
+        let first = vec![0x37; 2048];
+        let second = vec![0x42; 9000];
+        let mut framed = Compression::Snappy.codec_compress(&first).unwrap();
+        let next = Compression::Snappy.codec_compress(&second).unwrap();
+        framed.extend_from_slice(&next[16..]);
+        let expected = [first, second].concat();
+        assert_eq!(
+            snappy_decompress(&framed, expected.len()).unwrap(),
+            expected
+        );
+        assert!(snappy_decompress(&framed, expected.len() - 1)
+            .unwrap_err()
+            .to_string()
+            .contains("maximum allowable size"));
+        for tail in [vec![0], vec![0, 0], vec![0, 0, 0]] {
+            let mut trailing = framed.clone();
+            trailing.extend(tail);
+            assert!(snappy_decompress(&trailing, expected.len()).is_err());
+        }
+        // A valid decoded-length hint with missing tags is still rejected.
+        let mut corrupt = framed;
+        corrupt.extend_from_slice(&1u32.to_be_bytes());
+        corrupt.push(3);
+        assert!(snappy_decompress(&corrupt, expected.len() + 3).is_err());
+    }
