+    #[test]
+    fn other_batch_drains_preserve_queue_storage_and_order() {
+        for scenario in 0..4 {
+            let (mut pending, mut spare, count) = match scenario {
+                0 => (Vec::with_capacity(8), Vec::with_capacity(8), 0),
+                1 => (Vec::with_capacity(8), Vec::with_capacity(8), 2),
+                2 => {
+                    let spare: Vec<Pending> = Vec::with_capacity(4);
+                    let pending = Vec::with_capacity(spare.capacity().saturating_add(1));
+                    (pending, spare, 4)
+                }
+                _ => {
+                    let pending: Vec<Pending> = Vec::with_capacity(4);
+                    let spare = Vec::with_capacity(pending.capacity().saturating_add(1));
+                    (pending, spare, 4)
+                }
+            };
+            pending.extend((0..4).map(|partition| queued("orders", Some(partition))));
+            let pending_ptr = pending.as_ptr();
+            let capacity = pending.capacity();
+            if count == 4 {
+                assert_ne!(pending.capacity(), spare.capacity());
+            }
+
+            let batch = fill_spare(&mut spare, &mut pending, count);
+
+            assert_eq!(pending.as_ptr(), pending_ptr);
+            assert_eq!(pending.capacity(), capacity);
+            assert!(spare.is_empty());
+            assert_eq!(
+                batch
+                    .iter()
+                    .map(|item| item.rec.partition)
+                    .collect::<Vec<_>>(),
+                (0_i32..4).take(count).map(Some).collect::<Vec<_>>()
+            );
+            assert_eq!(
+                pending
+                    .iter()
+                    .map(|item| item.rec.partition)
+                    .collect::<Vec<_>>(),
+                (0_i32..4).skip(count).map(Some).collect::<Vec<_>>()
+            );
+        }
+    }
