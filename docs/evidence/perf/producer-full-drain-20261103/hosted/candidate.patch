     #[test]
+    fn full_batch_drain_preserves_order_and_delivery_ownership() {
+        let mut pending = (0..8)
+            .map(|partition| queued("orders", Some(partition)))
+            .collect::<Vec<_>>()
+            .into_boxed_slice()
+            .into_vec();
+        pending.truncate(4);
+        let mut spare = (0..8)
+            .map(|partition| queued("unused", Some(partition)))
+            .collect::<Vec<_>>()
+            .into_boxed_slice()
+            .into_vec();
+        spare.clear();
+        let mut receivers = Vec::new();
+        for record in &mut pending {
+            let (result, receiver) = oneshot::channel();
+            record.tx = Some(result);
+            receivers.push(receiver);
+        }
+        let queue_capacity = pending.capacity();
+        let spare_capacity = spare.capacity();
+        let pending_ptr = pending.as_ptr();
+        let spare_ptr = spare.as_ptr();
+
+        let batch = fill_spare(&mut spare, &mut pending, 4);
+
+        assert_eq!(queue_capacity, spare_capacity);
+        assert_eq!(batch.as_ptr(), pending_ptr);
+        assert_eq!(pending.as_ptr(), spare_ptr);
+        assert_eq!(batch.capacity(), spare_capacity);
+        assert_eq!(pending.capacity(), queue_capacity);
+        assert!(pending.is_empty());
+        assert!(spare.is_empty());
+        assert_eq!(spare.capacity(), 0);
+        assert_eq!(
+            batch
+                .iter()
+                .map(|item| item.rec.partition)
+                .collect::<Vec<_>>(),
+            vec![Some(0), Some(1), Some(2), Some(3)]
+        );
+        for receiver in &mut receivers {
+            assert!(matches!(
+                receiver.try_recv(),
+                Err(oneshot::error::TryRecvError::Empty)
+            ));
+        }
+        drop(batch);
+        for mut receiver in receivers {
+            assert!(matches!(
+                receiver.try_recv(),
+                Err(oneshot::error::TryRecvError::Closed)
+            ));
+        }
+    }
